---
import '../styles/global.css';
import { withBase } from '../lib/paths';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideChrome?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Websites for small businesses and organizations, built by Jacob Huber in Edwardsville, Illinois. Explore website builds, redesigns, and custom software help.',
  image = '/images/portrait.jpeg',
  hideChrome = false,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · Jacob Huber` : 'Jacob Huber · Websites for Small Businesses';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const navItems = [
  { href: '/services/', label: 'Services' },
  { href: '/projects/', label: 'My work' },
  { href: '/about/', label: 'About me' },
  { href: '/contact/', label: 'Start a project' },
];
const isActive = (href: string) => Astro.url.pathname === withBase(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fff9ef" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jacob Huber" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Jacob Huber" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    {!hideChrome && (
      <header class="site-header">
        <div class="container header-inner">
          <a href={withBase('/')} aria-label="Jacob Huber home" class="wordmark">
            <span class="monogram" aria-hidden="true">jh.</span>
            <span>Jacob Huber<span class="wordmark-note">Websites & software</span></span>
          </a>
          <nav aria-label="Main navigation" class="desktop-navigation">
            {navItems.map((item) => (
              <a href={withBase(item.href)} class={item.href === '/contact/' ? 'nav-cta' : undefined} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>
          <details class="mobile-menu">
            <summary>Menu <span aria-hidden="true">+</span></summary>
            <nav aria-label="Mobile navigation">
              <a href={withBase('/')} aria-current={isActive('/') ? 'page' : undefined}>Home</a>
              {navItems.map((item) => (
                <a href={withBase(item.href)} class={item.href === '/contact/' ? 'nav-cta' : undefined} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              ))}
            </nav>
          </details>
        </div>
      </header>
    )}
    <main id="main-content" tabindex="-1"><slot /></main>
    {!hideChrome && (
      <footer class="site-footer">
        <div class="container">
          {!isActive('/contact/') && <div class="footer-top">
            <h2>Let’s talk about your website.</h2>
            <a href={withBase('/contact/')} class="button button-light">Start a project <Icon name="arrow-up-right" size={18} /></a>
          </div>}
          <div class="footer-bottom">
            <p>© <span id="copyright-year">2026</span> Jacob Huber <span class="footer-location">· Edwardsville, Illinois</span></p>
            <div class="footer-links">
              <nav aria-label="Footer navigation">
                <a href={withBase('/')}>Home</a>
                <a href={withBase('/experience/')}>Résumé</a>
                <a href="mailto:jhuber.mail@icloud.com">Email</a>
              </nav>
              <SocialLinks />
            </div>
          </div>
        </div>
      </footer>
    )}
    <script>
      const copyrightYear = document.getElementById('copyright-year');
      if (copyrightYear) copyrightYear.textContent = String(new Date().getFullYear());
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      const header = document.querySelector<HTMLElement>('.site-header');
      if (header) {
        // Clamp overscroll so the bounce at either end doesn't reverse the header.
        const scrollPosition = () => Math.max(0, Math.min(
          window.scrollY,
          document.documentElement.scrollHeight - window.innerHeight,
        ));
        let lastPosition = scrollPosition();
        let direction = 0;
        let distance = 0;

        const showHeader = () => {
          header.classList.remove('is-hidden');
          lastPosition = scrollPosition();
          direction = 0;
          distance = 0;
        };

        window.addEventListener('scroll', () => {
          const position = scrollPosition();
          const delta = position - lastPosition;
          lastPosition = position;

          if (position <= header.offsetHeight || menu?.open || header.querySelector(':focus-visible')) {
            showHeader();
            return;
          }
          if (delta === 0) return;

          const nextDirection = Math.sign(delta);
          distance = nextDirection === direction ? distance + Math.abs(delta) : Math.abs(delta);
          direction = nextDirection;

          // Ignore tiny scroll reversals from a trackpad or touch gesture.
          if (distance >= 10) {
            header.classList.toggle('is-hidden', direction > 0);
            distance = 0;
          }
        }, { passive: true });

        header.addEventListener('focusin', showHeader);
        menu?.addEventListener('toggle', () => {
          if (menu.open) showHeader();
        });
        window.addEventListener('resize', () => {
          if (menu && menu.offsetParent === null) menu.open = false;
          showHeader();
        });
        window.addEventListener('pageshow', showHeader);
      }
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
