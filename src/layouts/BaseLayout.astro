---
import '../styles/global.css';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideChrome?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Meet Jacob Huber: software engineer, husband, dad, and independent website builder in Edwardsville, Illinois. Explore my experience, projects, and services.',
  image = '/images/portrait.jpeg',
  hideChrome = false,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · Jacob Huber` : 'Jacob Huber · Software Engineer & Builder';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const navItems = [
  { href: '/about/', label: 'About' },
  { href: '/experience/', label: 'Experience' },
  { href: '/projects/', label: 'Projects' },
  { href: '/services/', label: 'Services' },
  { href: '/contact/', label: 'Contact' },
];
const isActive = (href: string) => Astro.url.pathname === withBase(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f3ed" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jacob Huber" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Jacob Huber" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    {!hideChrome && (
      <header class="site-header">
        <div class="container header-inner">
          <a href={withBase('/')} aria-label="Jacob Huber home" class="wordmark">
            <span class="monogram" aria-hidden="true">jh.</span>
            <span>Jacob Huber<span class="wordmark-note">Engineer & builder</span></span>
          </a>
          <nav aria-label="Main navigation" class="desktop-navigation">
            {navItems.map((item) => (
              <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </nav>
          <details class="mobile-menu">
            <summary>Menu <span aria-hidden="true">+</span></summary>
            <nav aria-label="Mobile navigation">
              <a href={withBase('/')} aria-current={isActive('/') ? 'page' : undefined}>Home</a>
              {navItems.map((item) => (
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              ))}
            </nav>
          </details>
        </div>
      </header>
    )}
    <main id="main-content" tabindex="-1"><slot /></main>
    {!hideChrome && (
      <footer class="site-footer">
        <div class="container">
          <div class="footer-top">
            <div><p class="eyebrow">A conversation is a good start</p><h2>Let’s build something useful.</h2></div>
            <a href={withBase('/contact/')} class="button button-light">Get in touch <span aria-hidden="true">↗</span></a>
          </div>
          <div class="footer-bottom">
            <p>© <span id="copyright-year">2026</span> Jacob Huber <span class="footer-location">· Edwardsville, Illinois</span></p>
            <nav aria-label="Footer navigation">
              <a href={withBase('/')}>Home</a>
              <a href="https://www.linkedin.com/in/jacobhuberonline/">LinkedIn <span aria-hidden="true">↗</span></a>
              <a href="https://github.com/jacobhuberonline">GitHub <span aria-hidden="true">↗</span></a>
              <a href="mailto:jhuber.mail@icloud.com">Email <span aria-hidden="true">↗</span></a>
            </nav>
          </div>
        </div>
      </footer>
    )}
    <script>
      const copyrightYear = document.getElementById('copyright-year');
      if (copyrightYear) copyrightYear.textContent = String(new Date().getFullYear());
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
