---
import '../styles/global.css';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideChrome?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'Jacob Huber — software engineer building websites, integrations, and automation.',
  image = '/images/default-social.png',
  hideChrome = false,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · Jacob Huber` : 'Jacob Huber · Websites & Software';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const navItems = [
  { href: '/#services', label: 'Services' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const footerItems = [{ href: '/', label: 'Home' }, ...navItems];
const isActive = (href: string) => !href.includes('#') && Astro.url.pathname === withBase(href);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jacob Huber" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Jacob Huber" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline>
      // Apply the system theme before paint and follow later system changes.
      const theme = window.matchMedia('(prefers-color-scheme: dark)');
      document.documentElement.classList.toggle('dark', theme.matches);
      theme.addEventListener('change', (event) => {
        document.documentElement.classList.toggle('dark', event.matches);
      });
    </script>
  </head>
  <body class="min-h-screen overflow-x-hidden bg-neutral-50 text-neutral-900 dark:bg-neutral-950 dark:text-neutral-50">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:p-3 focus:text-neutral-900">Skip to content</a>
    <div class="flex min-h-screen flex-col">
      {!hideChrome && (
        <header class="border-b border-neutral-200 bg-white/80 backdrop-blur dark:border-neutral-800 dark:bg-neutral-900/80">
          <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6">
            <a href={withBase('/')} aria-label="Jacob Huber home" class="text-base font-semibold">JH</a>
            <nav aria-label="Main navigation" class="flex flex-wrap items-center gap-4 sm:gap-6">
              {navItems.map((item) => (
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined} class:list={[
                  'text-sm font-medium text-neutral-700 transition hover:text-neutral-900 dark:text-neutral-200 dark:hover:text-neutral-50',
                  { 'underline underline-offset-4': isActive(item.href) },
                ]}>{item.label}</a>
              ))}
            </nav>
          </div>
        </header>
      )}
      <main id="main-content" class="mx-auto w-full max-w-7xl flex-1 px-4 py-10 sm:px-6"><slot /></main>
      {!hideChrome && (
        <footer class="border-t border-neutral-200 bg-white/80 backdrop-blur dark:border-neutral-800 dark:bg-neutral-900/80">
          <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500 dark:text-neutral-400">© <span id="copyright-year">2026</span> Jacob Huber</p>
            <nav aria-label="Footer navigation" class="flex flex-wrap items-center gap-4 text-sm font-medium text-neutral-700 dark:text-neutral-200">
              {footerItems.map((item) => <a href={withBase(item.href)} class="transition hover:text-neutral-900 dark:hover:text-neutral-50">{item.label}</a>)}
            </nav>
          </div>
        </footer>
      )}
    </div>
    <script>
      const copyrightYear = document.getElementById('copyright-year');
      if (copyrightYear) copyrightYear.textContent = String(new Date().getFullYear());
    </script>
  </body>
</html>
