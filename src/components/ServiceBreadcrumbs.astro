---
import { withBase } from '../lib/paths';

interface Props { current: string; }
const { current } = Astro.props;
---

<nav aria-label="Breadcrumb" class="service-breadcrumbs">
  <ol>
    <li><a href={withBase('/')}>Home</a></li>
    <li><a href={withBase('/services/')}>Services</a></li>
    <li><span aria-current="page">{current}</span></li>
  </ol>
</nav>

<style>
  .service-breadcrumbs { margin-bottom: 22px; color: var(--muted); font-size: 12px; }
  ol { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  li { display: flex; align-items: center; gap: 8px; }
  li + li::before { content: '/'; color: var(--muted); }
  a { text-decoration: underline; text-underline-offset: 4px; }
</style>
