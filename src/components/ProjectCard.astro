---
import type { Project } from '../data/projects';
import { withBase } from '../lib/paths';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h2' } = Astro.props;
const projectUrl = project.url?.startsWith('/')
  ? withBase(project.url)
  : project.url;
---

<article class="flex h-full flex-col rounded-xl border border-neutral-200 bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
  <Heading class="text-lg font-semibold text-neutral-900 dark:text-neutral-50">
    {project.name}
  </Heading>
  <p class="mt-2 text-sm text-neutral-700 dark:text-neutral-200">
    {project.description}
  </p>
  <div class="mt-auto flex flex-col gap-3 pt-4 md:flex-row md:items-center md:justify-between">
    <ul class="flex flex-wrap gap-2" aria-label="Technologies">
      {project.tech.map((tech) => (
        <li class="rounded-full bg-neutral-100 px-3 py-1 text-xs font-medium text-neutral-700 dark:bg-neutral-800 dark:text-neutral-200">
          {tech}
        </li>
      ))}
    </ul>
    {projectUrl && (
      <a
        href={projectUrl}
        aria-label={`View ${project.name}`}
        class="inline-flex text-sm font-semibold text-neutral-900 underline decoration-neutral-300 underline-offset-4 transition hover:decoration-neutral-600 dark:text-neutral-100 dark:decoration-neutral-700 dark:hover:decoration-neutral-400"
      >
        View
      </a>
    )}
  </div>
</article>
