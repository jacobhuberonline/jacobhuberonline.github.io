---
import type { Project } from '../data/projects';
import { withBase } from '../lib/paths';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
  featured?: boolean;
}

const { project, headingLevel: Heading = 'h2', featured = false } = Astro.props;
const projectUrl = project.url?.startsWith('/')
  ? withBase(project.url)
  : project.url;
const linkLabel = project.url?.startsWith('https://github.com/') ? 'See the code' : 'See the site';
const cardTags = featured ? project.highlights : project.tech;
---

<article class:list={['project-card', { 'project-card-featured': featured }]}>
  <div class:list={['project-preview', `project-preview-${project.accent}`]} aria-hidden="true">
    <div class="preview-topline">
      <span>{project.category}</span>
    </div>
    <div class="preview-title">{project.name}</div>
    <div class="preview-bottomline">
      <span>{project.highlights.slice(0, 2).join(' · ')}</span>
      <span class="preview-symbol">↗</span>
    </div>
  </div>

  <div class="project-copy">
    <Heading class="project-title">{project.name}</Heading>
    <p class="project-description">{project.description}</p>
    <div class="project-footer">
      <ul class="tag-list" aria-label={featured ? 'Website features' : 'Technologies'}>
        {cardTags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
      {projectUrl && (
        <a href={projectUrl} aria-label={`${linkLabel}: ${project.name}`} class="text-link project-link">
          {linkLabel} <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 0.7rem;
    border: 1px solid var(--line, #e4ded2);
    border-radius: 20px;
    background: var(--paper, #fffdf7);
  }

  .project-preview {
    --preview-ink: #344238;
    --preview-background: var(--peach, #f6c8a7);
    min-height: 230px;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    overflow: hidden;
    color: var(--preview-ink);
    background: var(--preview-background);
    border-radius: 14px;
  }

  .project-preview-forest { --preview-ink: #edf0dd; --preview-background: #314b3f; }
  .project-preview-moss { --preview-ink: #293d2b; --preview-background: #e0eaa9; }
  .project-preview-stone { --preview-ink: #334642; --preview-background: #d5e5df; }

  .preview-topline,
  .preview-bottomline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.77rem;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  .preview-topline { opacity: 0.85; }

  .preview-title {
    max-width: 15ch;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .preview-bottomline {
    padding-top: 0.6rem;
  }

  .preview-symbol { font-size: 1.2rem; line-height: 1; }
  .project-card-featured .project-preview { min-height: 310px; }
  .project-card-featured .preview-title { font-size: clamp(2.5rem, 4.6vw, 4.25rem); }

  .project-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.4rem 0.6rem 0.6rem;
  }

  .project-title { margin: 0; font-size: clamp(1.55rem, 2.2vw, 2rem); line-height: 1.18; }
  .project-description { margin: 0.85rem 0 1.6rem; color: var(--muted, #5b6860); line-height: 1.75; font-size: 0.96rem; }
  .project-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; justify-content: space-between; margin-top: auto; padding-top: 0.6rem; }
  .project-footer .tag-list { margin: 0; }
  .project-link { font-size: 0.78rem; white-space: nowrap; }

  @media (max-width: 600px) {
    .project-preview,
    .project-card-featured .project-preview { min-height: 245px; }
    .project-card-featured .preview-title { font-size: 2.6rem; }
  }
</style>
