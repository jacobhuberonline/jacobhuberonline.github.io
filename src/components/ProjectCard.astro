---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
  featured?: boolean;
}

const { project, headingLevel: Heading = 'h2', featured = false } = Astro.props;
const projectUrl = project.url?.startsWith('/')
  ? withBase(project.url)
  : project.url;
const linkLabel = project.url?.startsWith('https://github.com/') ? 'See the code' : 'See the site';
const previewHost = projectUrl?.startsWith('https://') ? new URL(projectUrl).hostname.replace(/^www\./, '') : '';
const storyUrl = project.caseStudy ? withBase(`/projects/${project.caseStudy.slug}/`) : undefined;
---

<article class:list={['project-card', { 'project-card-featured': featured }]}>
  {project.caseStudy ? (
    <div class="project-screenshot">
      <div class="browser-bar"><span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{previewHost}</span></div>
      <a href={storyUrl} aria-label={`Read draft project story: ${project.name}`}>
        <Image src={project.caseStudy.screenshot} alt={project.caseStudy.screenshotAlt} width={1152} format="webp" quality={85} loading="lazy" decoding="async" />
      </a>
    </div>
  ) : (
  <div class:list={['project-preview', `project-preview-${project.accent}`]}>
    <div class="preview-topline">
      <span>{project.category}</span>
    </div>
    <Heading class="preview-title">{project.name}</Heading>
  </div>
  )}

  <div class="project-copy">
    {project.caseStudy ? (
      <>
        <p class="project-category">{project.category}</p>
        <Heading class="case-title">{project.name}</Heading>
        <p class="project-description case-introduction">{project.description}</p>
      </>
    ) : <p class="project-description">{project.description}</p>}
    {project.testimonial && (
      <figure class="client-testimonial">
        <blockquote><p>“{project.testimonial.quote}”</p></blockquote>
        <figcaption>— {project.testimonial.attribution} <span>· Client testimonial</span></figcaption>
      </figure>
    )}
    <div class="project-footer">
      {storyUrl && <a href={storyUrl} aria-label={`Read draft story: ${project.name}`} class="text-link project-link">Read draft story <Icon name="arrow-up-right" size={18} /></a>}
      {!featured && <ul class="tag-list" aria-label="Technologies">
        {project.tech.map((tag) => <li class="tag">{tag}</li>)}
      </ul>}
      {projectUrl && (
        <a href={projectUrl} aria-label={`${linkLabel}: ${project.name}`} class="text-link project-link">
          {linkLabel} <Icon name="arrow-up-right" size={18} />
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 0.7rem;
    border: 1px solid var(--line, #e4ded2);
    border-radius: 20px;
    background: var(--paper, #fffdf7);
  }

  .project-preview {
    --preview-ink: #344238;
    --preview-background: var(--peach, #f6c8a7);
    min-height: 200px;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    overflow: hidden;
    color: var(--preview-ink);
    background: var(--preview-background);
    border-radius: 14px;
  }

  .project-preview-forest { --preview-ink: #edf0dd; --preview-background: #314b3f; }
  .project-preview-moss { --preview-ink: #293d2b; --preview-background: #e0eaa9; }
  .project-preview-stone { --preview-ink: #334642; --preview-background: #d5e5df; }

  .preview-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.77rem;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  .preview-topline { opacity: 0.85; }

  .preview-title {
    max-width: 15ch;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .project-card-featured .project-preview { min-height: 240px; }
  .project-card-featured .preview-title { font-size: clamp(2.5rem, 4.6vw, 4.25rem); }

  .project-screenshot { border: 1px solid var(--line); border-radius: 13px; overflow: hidden; background: var(--canvas); }
  .browser-bar { display: flex; align-items: center; gap: 14px; min-height: 35px; padding: 8px 13px; color: var(--muted); font-size: 11px; }
  .browser-dots { display: flex; gap: 4px; }
  .browser-dots i { width: 6px; height: 6px; border-radius: 50%; background: #b9c2b5; }
  .project-screenshot a { display: block; }
  .project-screenshot a:focus-visible { outline-offset: -5px; }
  .project-screenshot img { width: 100%; height: auto; }
  .project-category { color: var(--forest); font-size: 12px; margin-bottom: 9px; }
  .case-title { font-size: clamp(1.6rem, 2.5vw, 2rem); line-height: 1.2; }
  .project-description.case-introduction { margin-top: 16px; font-size: 14px; }
  .client-testimonial { margin: 0 0 20px; padding: 18px 20px; border-left: 3px solid var(--forest); border-radius: 0 12px 12px 0; background: #eef2dc; }
  .client-testimonial blockquote { margin: 0; color: var(--forest); font-size: 15px; line-height: 1.7; }
  .client-testimonial figcaption { margin-top: 12px; color: var(--ink); font-size: 12px; font-weight: 600; }
  .client-testimonial figcaption span { color: var(--muted); font-weight: 400; }

  .project-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.2rem 0.6rem 0.6rem;
  }

  .project-description { margin: 0 0 1rem; color: var(--muted, #5b6860); line-height: 1.75; font-size: 1rem; }
  .project-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; justify-content: space-between; margin-top: auto; padding-top: 0.6rem; }
  .project-footer .tag-list { margin: 0; }
  .project-link { font-size: 0.78rem; white-space: nowrap; }

  @media (max-width: 600px) {
    .project-preview,
    .project-card-featured .project-preview { min-height: 210px; }
    .project-card-featured .preview-title { font-size: 2.6rem; }
  }
</style>
