---
import { formatPrice, type ServiceOffer } from '../data/services';
import Icon from './Icon.astro';
import { withBase } from '../lib/paths';

interface Props {
  offers: ServiceOffer[];
  headingLevel?: 'h2' | 'h3';
}

const { offers, headingLevel: Heading = 'h2' } = Astro.props;
const automationOnly = offers.every((offer) => offer.id === 'workflow-automation');
---

<div class:list={['offer-grid', { 'single-offer': offers.length === 1 }]} style={`--offer-columns: ${offers.length}`}>
  {offers.map((offer) => (
    <article class="offer-card" id={offer.id} aria-labelledby={`${offer.id}-title`}>
      <span class="offer-icon"><Icon name={offer.icon} /></span>
      <Heading id={`${offer.id}-title`}>{offer.title}</Heading>
      <p class="offer-fit">{offer.fit}</p>
      <p class="offer-price"><span>Starting at</span> <strong>{formatPrice(offer.startingPrice)}</strong></p>
      <p class="offer-price-unit">USD · one-time project</p>
      <ul aria-label={`Included with ${offer.title.toLowerCase()}`}>
        {offer.included.map((item) => <li><Icon name="check" size={17} /><span>{item}</span></li>)}
      </ul>
      <a class="text-link" href={withBase(`/contact/?service=${offer.id}`)} aria-label={`Get an estimate: ${offer.title}`}>Get a project estimate <Icon name="arrow-up-right" size={18} /></a>
    </article>
  ))}
</div>
<p class="pricing-note">{automationOnly
  ? 'Assumes tool access and sample data. Your quote fixes the scope and price; ongoing monitoring and support are separate.'
  : 'Website prices assume ready-to-use content. Your quote fixes the scope and price; hosting and care are separate.'}</p>

<style>
  .offer-grid { display: grid; grid-template-columns: repeat(var(--offer-columns), minmax(0, 1fr)); gap: 20px; }
  .offer-card { display: flex; flex-direction: column; padding: clamp(24px, 3vw, 34px); border: 1px solid var(--line); border-radius: 22px; background: var(--paper); }
  .offer-card:first-child { background: #f9dfc7; border-color: #e9c9ab; }
  .offer-card:last-child:not(:first-child) { background: #eef2dc; }
  .offer-icon { display: grid; place-items: center; width: 46px; height: 46px; background: var(--paper); color: var(--forest); border-radius: 13px; margin-bottom: 24px; }
  .offer-card h2, .offer-card h3 { font-size: clamp(1.45rem, 2.3vw, 1.8rem); line-height: 1.18; }
  .offer-fit { color: var(--muted); font-size: 14px; line-height: 1.6; margin-top: 13px; }
  .offer-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 10px; margin-top: 22px; color: var(--forest); }
  .offer-price span { font-size: 14px; }
  .offer-price strong { font-size: 2rem; line-height: 1.2; letter-spacing: -.04em; }
  .offer-price-unit { color: var(--muted); font-size: 12px; margin-top: 5px; }
  .pricing-note { max-width: 76ch; margin-top: 22px; color: var(--muted); font-size: 13px; line-height: 1.7; }
  ul { list-style: none; display: grid; gap: 13px; margin: 25px 0 30px; padding: 0; }
  li { display: flex; align-items: start; gap: 10px; font-size: 14px; line-height: 1.55; }
  li :global(svg) { margin-top: 3px; color: var(--forest); }
  .offer-card .text-link { margin-top: auto; align-self: start; }
  .single-offer { max-width: 740px; }
  @media (max-width: 850px) {
    .offer-grid { grid-template-columns: 1fr; }
    .offer-card h2, .offer-card h3 { font-size: 1.65rem; }
  }
</style>
