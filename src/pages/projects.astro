---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { withBase } from '../lib/paths';

const featuredProjects = projects.slice(0, 2);
const moreProjects = projects.slice(2);
---

<BaseLayout
  title="Projects"
  description="Explore websites Jacob Huber has built for businesses and organizations, including KRH Design Co. and VEST First Responder, and talk about your next project."
>
  <div class="container">
    <header class="page-intro">
      <h1 class="display-title">A few websites I’ve built.</h1>
      <p class="lede">
        See how different businesses share their work, explain their services,
        and help visitors take the next step. Then let’s talk about what you
        need your website to do.
      </p>
      <div class="button-row projects-actions">
        <a class="button" href={withBase('/contact/')}>Start a project <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={withBase('/services/')}>See how I can help <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="section featured-work" aria-labelledby="featured-heading">
      <div class="section-heading">
        <div>
          <h2 id="featured-heading">Two examples to explore.</h2>
        </div>
        <p>An interior designer’s services and work. A training team’s courses and resources. Each site has a different job to do.</p>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} headingLevel="h3" featured />)}
      </div>
    </section>

    <section class="section" aria-labelledby="more-work-heading">
      <div class="section-heading">
        <div>
          <h2 id="more-work-heading">More websites and useful tools.</h2>
        </div>
        <p>Photography, community projects, and tools for the work that happens behind the scenes.</p>
      </div>
      <div class="project-grid more-projects">
        {moreProjects.map((project) => <ProjectCard project={project} headingLevel="h3" />)}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .featured-work { padding-top: 0; }
  .projects-actions { margin-top: 1.75rem; }
  .more-projects { row-gap: 3.5rem; }
</style>
