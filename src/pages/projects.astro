---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AutomationPreview from '../components/AutomationPreview.astro';
import { projects } from '../data/projects';
import { projectStories } from '../data/project-stories';
import { withBase } from '../lib/paths';

const featuredProjects = projects.slice(0, 2);
const moreProjects = projects.slice(2);
---

<BaseLayout
  title="Website Design Portfolio: KRH, VEST & More"
  description="Explore websites Jacob Huber has built for businesses and organizations, including KRH Design Co. and VEST First Responder, and talk about your next project."
>
  <div class="container">
    <header class="page-intro">
      <h1 class="display-title">A few websites I’ve built.</h1>
      <p class="lede">The work, and the thinking behind it.</p>
      <div class="button-row projects-actions">
        <a class="button" href={withBase('/contact/')}>Start a project <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={withBase('/services/')}>See how I can help <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="section featured-work" aria-labelledby="featured-heading">
      <div class="section-heading">
        <h2 id="featured-heading">Behind the websites.</h2>
        <p>Real websites. Illustrative stories until the client details are confirmed.</p>
      </div>
      <div class="featured-stories">
        {featuredProjects.map((project) => project.caseStudy && (
          <article class="story-preview">
            <a class="story-preview-image" href={withBase(`/projects/${project.caseStudy.slug}/`)} aria-label={`Read draft project story: ${project.name}`}>
              <Image src={project.caseStudy.screenshot} alt={project.caseStudy.screenshotAlt} width={960} widths={[360, 720, 960]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1280px) 48vw, 596px" format="webp" quality={85} loading="lazy" decoding="async" />
            </a>
            <div class="story-preview-copy">
              <p class="eyebrow">{project.category} · Placeholder story</p>
              <h3>{project.name}</h3>
              <p class="story-hook">{projectStories[project.caseStudy.slug].title}</p>
              <a class="text-link" href={withBase(`/projects/${project.caseStudy.slug}/`)} aria-label={`Read draft story: ${project.name}`}>Read draft story <Icon name="arrow-up-right" size={18} /></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <AutomationPreview />

    <section class="section" aria-labelledby="more-work-heading">
      <div class="section-heading">
        <div>
          <h2 id="more-work-heading">More projects.</h2>
        </div>
      </div>
      <div class="project-grid more-projects">
        {moreProjects.map((project) => <ProjectCard project={project} headingLevel="h3" />)}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .featured-work { padding-top: 0; }
  .projects-actions { margin-top: 1.75rem; }
  .more-projects { row-gap: 3.5rem; }
  .featured-stories { display: grid; gap: 36px; }
  .story-preview { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); align-items: center; padding-bottom: 36px; border-bottom: 1px solid var(--line); }
  .story-preview:last-child { padding-bottom: 0; border-bottom: 0; }
  .story-preview-image { display: block; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .story-preview-image:focus-visible { outline-offset: -5px; }
  .story-preview-image img { width: 100%; height: auto; }
  .story-preview h3 { font-size: clamp(1.7rem, 3vw, 2.3rem); margin-top: 12px; }
  .story-hook { margin-top: 16px; font-size: 19px; line-height: 1.5; color: var(--forest); }
  .story-preview .text-link { margin-top: 24px; }
  @media (max-width: 760px) { .story-preview { grid-template-columns: minmax(0, 1fr); } }
</style>
