---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AutomationPreview from '../components/AutomationPreview.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
import { formatPrice, serviceOffers, websiteCare } from '../data/services';
import { withBase } from '../lib/paths';
---
<BaseLayout>
  <div class="container">
    <section class="home-hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow">For small businesses & organizations</p>
        <h1 id="intro-title">Websites that help people <span>choose your business.</span></h1>
        <p class="lede">Business websites, thoughtful redesigns, and automation that takes repetitive work off your plate.</p>
        <div class="button-row">
          <a href={withBase('/contact/')} class="button">Get a project estimate <span aria-hidden="true">↗</span></a>
          <a href={withBase('/projects/')} class="text-link">See my work <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="hello-card" aria-label="Meet your website builder">
        <div class="hello-photo">
          <img src={withBase('/images/portrait.jpeg')} alt="Jacob Huber outdoors by the water" width="886" height="886" fetchpriority="high" decoding="async" />
          <span class="hello-wave" aria-hidden="true">👋</span>
        </div>
        <div class="hello-copy">
          <p class="hello-name">Hey, I’m Jacob.</p>
          <p>Software engineer & website builder.<br />Based in Edwardsville, Illinois.<br />Working with local & nationwide clients.</p>
          <a href={withBase('/about/')} class="text-link">Get to know me <span aria-hidden="true">↗</span></a>
        </div>
      </aside>
    </section>

    <section id="services" class="section" aria-labelledby="services-heading">
      <div class="section-heading">
        <h2 id="services-heading">What do you need?</h2>
        <a href={withBase('/services/')} class="text-link">Explore services <span aria-hidden="true">↗</span></a>
      </div>
      <div class="service-grid">
        {serviceOffers.map((service) => (
          <a class="service-card" href={withBase(service.href)}>
            <div class="service-card-top">
              <span class="service-symbol"><Icon name={service.icon} /></span>
              <Icon name="arrow-up-right" size={18} />
            </div>
            <h3>{service.title}</h3>
            <p class="service-description">{service.description}</p>
            <p class="service-price">Starting at {formatPrice(service.startingPrice)} <span>USD</span></p>
          </a>
        ))}
      </div>
      <p class="service-pricing-note">One-time projects. Final scope and price agreed before work begins.</p>
      <a class="care-link" href={withBase('/services/#website-care')}>
        <Icon name="tools" size={22} />
        <span><strong>Want me to keep it running?</strong> Website care from {formatPrice(websiteCare.monthlyPrice)}/month, after the build.</span>
        <Icon name="arrow-up-right" size={18} />
      </a>
    </section>

    <section class="section" aria-labelledby="work-heading">
      <div class="section-heading">
        <h2 id="work-heading">A look at the work.</h2>
        <a href={withBase('/projects/')} class="text-link">More projects <span aria-hidden="true">↗</span></a>
      </div>
      <div class="project-grid">
        {projects.slice(0, 2).map((project) => <ProjectCard project={project} headingLevel="h3" featured />)}
      </div>
    </section>
    <AutomationPreview />
  </div>
</BaseLayout>

<style>
  .home-hero { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, .85fr); gap: clamp(45px, 7vw, 100px); align-items: center; padding: 62px 0 48px; }
  .hero-copy > .eyebrow { color: var(--forest); margin-bottom: 22px; }
  h1 { max-width: 15ch; font-size: clamp(3.25rem, 5.5vw, 4.7rem); line-height: 1.06; }
  h1 span { color: var(--forest); }
  .hero-copy .lede { max-width: 520px; font-size: 17px; line-height: 1.8; margin-top: 24px; }
  .hero-copy .button-row { margin-top: 28px; }
  .hello-card { padding: 10px; background: #f9dfc7; border: 1px solid #e9c9ab; border-radius: 24px; transform: rotate(2deg); }
  .hello-photo { position: relative; }
  .hello-photo img { width: 100%; aspect-ratio: 1.35; object-fit: cover; object-position: center 35%; border-radius: 16px; }
  .hello-wave { position: absolute; right: 16px; bottom: -19px; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--accent); font-size: 26px; transform: rotate(-12deg); }
  .hello-copy { padding: 23px 15px 17px; }
  .hello-name { font-family: var(--heading-font); font-size: 24px; letter-spacing: -.035em; font-weight: 600; }
  .hello-copy > p + p { font-size: 13px; line-height: 1.8; color: #526056; margin-top: 9px; }
  .hello-copy .text-link { margin-top: 20px; font-size: 12px; }
  .service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .service-card { display: flex; flex-direction: column; align-items: start; background: var(--paper); padding: 28px; border: 1px solid var(--line); border-radius: 20px; transition: border-color .18s, transform .18s; }
  .service-card:hover { border-color: var(--forest); transform: translateY(-3px); }
  .service-card-top { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-bottom: 22px; color: var(--forest); }
  .service-card:first-child { background: #eef2dc; }
  .service-symbol { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: var(--peach); color: var(--forest); }
  .service-card:first-child .service-symbol { background: var(--accent); }
  .service-card h3 { font-size: 22px; }
  .service-description { color: var(--muted); font-size: 16px; line-height: 1.7; margin-top: 14px; }
  .service-price { margin-top: auto; padding-top: 22px; color: var(--forest); font-size: 18px; font-weight: 600; }
  .service-price span { font-size: 11px; font-weight: 400; }
  .service-pricing-note { margin-top: 18px; color: var(--muted); font-size: 13px; line-height: 1.7; }
  .care-link { display: flex; align-items: center; gap: 14px; padding: 20px 24px; margin-top: 24px; border-radius: 16px; background: #f9dfc7; color: var(--forest); font-size: 14px; line-height: 1.6; }
  .care-link span { flex: 1; }
  .care-link strong { display: block; }
  .care-link:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1000px) {
    .home-hero { gap: 36px; grid-template-columns: minmax(0, 1.4fr) minmax(0, .85fr); }
    h1 { font-size: clamp(3rem, 5.8vw, 4rem); }
    .service-card { padding: 23px; }
    .service-card h3 { font-size: 19px; }
  }
  @media (max-width: 700px) {
    .home-hero { grid-template-columns: 1fr; gap: 32px; padding: 40px 0 32px; }
    .hero-copy > .eyebrow { font-size: 11px; margin-bottom: 20px; }
    h1 { font-size: clamp(2.8rem, 10.6vw, 4rem); max-width: 16ch; }
    .hero-copy .lede { font-size: 16px; margin-top: 22px; }
    .hero-copy .button-row { margin-top: 24px; }
    .hello-card { display: grid; grid-template-columns: 92px 1fr; align-items: center; gap: 16px; padding: 18px; transform: none; border-radius: 20px; }
    .hello-photo img { aspect-ratio: .8; border-radius: 12px; object-position: center; }
    .hello-wave { width: 31px; height: 31px; right: -7px; bottom: -6px; font-size: 18px; }
    .hello-copy { padding: 0; }
    .hello-name { font-size: 21px; }
    .hello-copy > p + p { font-size: 12px; line-height: 1.7; margin-top: 6px; }
    .hello-copy .text-link { margin-top: 12px; font-size: 11px; }
    .service-grid { grid-template-columns: 1fr; gap: 16px; }
    .service-card { padding: 26px; }
    .service-card h3 { font-size: 23px; }
  }
</style>
