---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="About"
  description="Meet Jacob Huber: software engineer, husband, and dad in Edwardsville, Illinois. A little about my work and life beyond it."
>
  <div class="container">
    <header class="page-intro">
      <h1 class="display-title">Hi, I'm Jacob.</h1>
      <p class="lede">I'm a software engineer living in Edwardsville, Illinois, with my wife and son.</p>
    </header>

    <section class="section split-layout about-introduction" aria-labelledby="my-story">
      <figure class="about-portrait">
        <img
          src={withBase('/images/portrait.jpeg')}
          alt="Jacob Huber outdoors beside the water"
          width="886"
          height="886"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption class="meta">Dune Bird Winery · Northport, Michigan.</figcaption>
      </figure>
      <div class="prose-copy">
        <h2 id="my-story" class="section-heading">How I got here.</h2>
        <p>
          Before I worked in software, I ran a restaurant and helped people grow
          into managers. I later moved into healthcare technology, first in
          support and then in software engineering.
        </p>
        <p>
          Today, I work at symplr, where I build applications, connect systems,
          and automate repetitive work. I also help untangle the software and
          data problems that need a closer look.
        </p>
        <p>
          I build websites on the side, too. VEST First Responder and KRH Design
          Co. are two of the projects I've been working on. You can see those
          and more on my <a class="inline-link" href={withBase('/projects/')}>projects page</a>.
        </p>
        <a class="text-link" href={withBase('/experience/')}>See where I've worked <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="section split-layout" aria-labelledby="beyond-work">
      <div>
        <h2 id="beyond-work" class="section-heading">When I'm not working.</h2>
      </div>
      <div class="prose-copy">
        <p>
          I'm spending time with my wife and son or working on projects around
          our house. We've been making it our own, one improvement at a time.
        </p>
        <p>I also enjoy a game of chess and watching the St. Louis Blues.</p>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .about-introduction { align-items: start; }
  .about-portrait { margin: 0; }
  .about-portrait img { display: block; width: 100%; max-width: 30rem; height: auto; border-radius: 0.5rem; }
  .about-portrait figcaption { margin-top: 1rem; }
  .inline-link { text-decoration: underline; text-underline-offset: 0.2em; }
  .about-introduction .text-link { margin-top: 1.5rem; }
</style>
