---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ContactForm from '../components/ContactForm.astro';
import portrait from '../assets/portrait.jpeg';
import { CONTACT_EMAIL, CONTACT_SERVICE_OPTIONS, createContactDraft } from '../lib/contact-draft';
import { withBase } from '../lib/paths';

const defaultDraft = createContactDraft(null);
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT?.trim();
if (contactEndpoint) {
  const endpoint = new URL(contactEndpoint);
  const local = import.meta.env.DEV && ['localhost', '127.0.0.1'].includes(endpoint.hostname);
  if ((endpoint.protocol !== 'https:' && !(local && endpoint.protocol === 'http:')) || endpoint.username || endpoint.password) {
    throw new Error('PUBLIC_CONTACT_ENDPOINT must be an HTTPS URL (HTTP localhost is allowed in development).');
  }
}
---
<BaseLayout title="Start a Website or Automation Project" description="Contact Jacob Huber about a business website, redesign, or repetitive task you’d like to automate. Local and nationwide projects welcome.">
  <div class="container">
    <header class="page-intro contact-intro">
      <p class="eyebrow">Get a project estimate</p>
      <h1 class="display-title">Tell me what you<br />have in mind<span class="hello-dot">.</span></h1>
      <p class="lede">A rough idea is enough to start.</p>
      {!contactEndpoint && (
        <>
          <div class="contact-offer-choice" id="contact-offer-choice" hidden>
            <label for="contact-service">Project type <span>(optional)</span></label>
            <select id="contact-service" aria-describedby="contact-service-hint">
              <option value="">General enquiry</option>
              {CONTACT_SERVICE_OPTIONS.map((option) => <option value={option.id}>{option.label}</option>)}
            </select>
            <p class="meta" id="contact-service-hint">{defaultDraft.hint}</p>
          </div>
          <div class="button-row contact-first-action">
            <a class="button" id="project-email-link" href={defaultDraft.mailto} aria-describedby="email-draft-note"><Icon name="mail" /> Get a project estimate</a>
            <span class="meta" id="email-draft-note">Opens an editable email draft.</span>
          </div>
          <p class="sr-only" id="contact-service-status" role="status" aria-live="polite"></p>
          <a class="text-link compare-offers" href={withBase('/services/')}>Compare projects & website care <Icon name="arrow-up-right" size={18} /></a>
        </>
      )}
    </header>

    <div class:list={['contact-layout', { 'has-form': contactEndpoint }]}>
      {contactEndpoint && (
        <div>
          <ContactForm endpoint={contactEndpoint} />
          <a class="text-link compare-offers" href={withBase('/services/')}>Compare projects & website care <Icon name="arrow-up-right" size={18} /></a>
        </div>
      )}
      <section class="contact-grid" aria-label="Contact details">
      <div class="contact-panel">
        <div class="inbox-person">
          <Image src={portrait} alt="" width={128} height={128} format="webp" quality={80} loading="eager" decoding="async" />
          <div><h2>Jacob Huber</h2><p>Edwardsville, Illinois</p></div>
        </div>
        <p class="contact-email">{CONTACT_EMAIL}</p>
        <button type="button" class="copy-email" data-email={CONTACT_EMAIL}>
          <Icon name="copy" /><span class="copy-label">Copy email</span>
        </button>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </div>

      <div class="contact-context">
        <section aria-labelledby="contact-next-heading">
          <h2 id="contact-next-heading">What happens next.</h2>
          <ol class="contact-next-steps">
            <li>I usually reply within 1 business day to clarify the goal and scope.</li>
            <li>You get a written quote to review.</li>
            <li>Work starts after you approve.</li>
          </ol>
        </section>
        <section aria-labelledby="contact-social-heading">
          <h2 id="contact-social-heading">Find me online.</h2>
          <div class="social-profiles"><SocialLinks /></div>
        </section>
      </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { contactServiceFromSearch, createContactDraft } from '../lib/contact-draft';

  const offerChoice = document.getElementById('contact-offer-choice');
  const serviceSelect = document.querySelector<HTMLSelectElement>('#contact-service');
  const serviceHint = document.getElementById('contact-service-hint');
  const emailLink = document.querySelector<HTMLAnchorElement>('#project-email-link');
  const serviceStatus = document.getElementById('contact-service-status');

  if (offerChoice && serviceSelect && serviceHint && emailLink && serviceStatus) {
    const updateDraft = (value: unknown, announce = false) => {
      const draft = createContactDraft(value);
      serviceSelect.value = draft.service ?? '';
      serviceHint.textContent = draft.hint;
      emailLink.href = draft.mailto;
      if (announce) serviceStatus.textContent = `${draft.label} selected. Your email draft is ready.`;
    };

    updateDraft(contactServiceFromSearch(window.location.search));
    offerChoice.hidden = false;
    serviceSelect.addEventListener('change', () => {
      const draft = createContactDraft(serviceSelect.value);
      updateDraft(draft.service, true);
      const url = new URL(window.location.href);
      if (draft.service) url.searchParams.set('service', draft.service);
      else url.searchParams.delete('service');
      window.history.replaceState(window.history.state, '', url);
    });
    window.addEventListener('popstate', () => updateDraft(contactServiceFromSearch(window.location.search)));
  }

  const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
  const copyLabel = copyButton?.querySelector<HTMLElement>('.copy-label');
  const copyStatus = document.querySelector<HTMLElement>('.copy-status');
  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.email;
    if (!email || !copyStatus || !copyLabel) return;
    copyLabel.textContent = 'Copy email';
    copyStatus.textContent = '';
    try {
      await navigator.clipboard.writeText(email);
      copyLabel.textContent = 'Copied!';
      copyStatus.textContent = 'Email address copied.';
    } catch {
      copyStatus.textContent = 'Select and copy the address above.';
    }
  });
</script>

<style>
  .contact-intro { max-width: 850px; padding-bottom: 42px; }
  .contact-intro .display-title { font-size: clamp(2.8rem, 6vw, 4.7rem); }
  .contact-first-action { margin-top: 24px; }
  .contact-offer-choice { display: grid; gap: 8px; max-width: 420px; margin-top: 25px; }
  .contact-offer-choice[hidden] { display: none; }
  .contact-offer-choice label { font-size: 14px; font-weight: 600; }
  .contact-offer-choice label span { color: var(--muted); font-size: 12px; font-weight: 400; }
  .contact-offer-choice select { width: 100%; min-height: 48px; padding: 11px 35px 11px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); color: var(--ink); font: inherit; font-size: 15px; }
  .compare-offers { margin-top: 22px; }
  .hello-dot { color: #ad532f; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: clamp(2.5rem, 6vw, 5rem); padding: 8px 0 64px; align-items: center; }
  .contact-panel { padding: clamp(1.7rem, 3.5vw, 2.5rem); color: var(--ink); background: #f9dfc7; border: 1px solid #e9c9ab; border-radius: 24px; box-shadow: 4px 7px 0 #f0dec957; }
  .inbox-person { display: flex; align-items: center; gap: 13px; margin-bottom: 26px; }
  .inbox-person img { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; }
  .inbox-person h2 { font-family: inherit; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
  .inbox-person p { font-size: 12px; color: var(--muted); margin-top: 5px; }
  .contact-email { font-size: clamp(1rem, 1.6vw, 1.18rem); font-weight: 600; overflow-wrap: anywhere; user-select: all; }
  .copy-email { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; padding: 10px 0; margin-top: 8px; }
  .copy-label { text-decoration: underline; text-underline-offset: 4px; }
  .copy-status { font-size: 11px; min-height: 1.8em; margin-top: 4px; color: #526056; }
  .contact-context h2 { font-size: 1.65rem; }
  .contact-context > section + section { margin-top: 2.5rem; }
  .has-form { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 40px; align-items: start; padding-bottom: 64px; }
  .has-form .contact-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; padding: 0; }
  .has-form .contact-panel { padding: 28px; }
  .contact-next-steps { padding-left: 1.25rem; margin: 1rem 0 0; list-style: decimal; color: var(--muted); font-size: 14px; line-height: 1.75; }
  .contact-next-steps li + li { margin-top: 0.5rem; }
  .social-profiles { margin-top: 28px; }
  @media (max-width: 800px) {
    .has-form { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-bottom: 40px; }
    .contact-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; padding-bottom: 40px; }
    .contact-panel { max-width: 540px; }
  }
</style>
