---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { withBase } from '../lib/paths';

const email = 'jhuber.mail@icloud.com';
const projectEmail = `mailto:${email}?subject=${encodeURIComponent('Project estimate: website or automation')}&body=${encodeURIComponent('Hi Jacob,\n\nMy business:\nProject type (starter website, business website/redesign, or automation):\nWhat I would like to improve:\nCurrent website or tools (if any):\nIdeal timing:\nBudget range (optional):\n\nThanks!')}`;
---
<BaseLayout title="Start a Website or Automation Project" description="Contact Jacob Huber about a business website, redesign, or repetitive task you’d like to automate. Local and nationwide projects welcome.">
  <div class="container">
    <header class="page-intro contact-intro">
      <p class="eyebrow">Get a project estimate</p>
      <h1 class="display-title">Tell me what you<br />have in mind<span class="hello-dot">.</span></h1>
      <p class="lede">Tell me what you need. I’ll help define the scope and send a written quote before work begins.</p>
      <div class="button-row contact-first-action">
        <a class="button" href={projectEmail}><Icon name="mail" /> Get a project estimate</a>
        <span class="meta">Opens an email with a few prompts to get started.</span>
      </div>
      <a class="text-link compare-offers" href={withBase('/services/')}>Compare the three project options <Icon name="arrow-up-right" size={18} /></a>
    </header>

    <section class="contact-grid" aria-label="Contact details">
      <div class="contact-panel">
        <div class="inbox-person">
          <img src={withBase('/images/portrait.jpeg')} alt="" width="64" height="64" decoding="async" />
          <div><h2>Jacob Huber</h2><p>Edwardsville, Illinois</p></div>
        </div>
        <p class="contact-email">{email}</p>
        <button type="button" class="copy-email" data-email={email}>
          <Icon name="copy" /><span class="copy-label">Copy email</span>
        </button>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </div>

      <div class="contact-context">
        <h2>Find me online.</h2>
        <div class="social-profiles"><SocialLinks /></div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
  const copyLabel = copyButton?.querySelector<HTMLElement>('.copy-label');
  const copyStatus = document.querySelector<HTMLElement>('.copy-status');
  copyButton?.addEventListener('click', async () => {
    const email = copyButton.dataset.email;
    if (!email || !copyStatus || !copyLabel) return;
    copyLabel.textContent = 'Copy email';
    copyStatus.textContent = '';
    try {
      await navigator.clipboard.writeText(email);
      copyLabel.textContent = 'Copied!';
      copyStatus.textContent = 'Email address copied.';
    } catch {
      copyStatus.textContent = 'Select and copy the address above.';
    }
  });
</script>

<style>
  .contact-intro { max-width: 850px; padding-bottom: 42px; }
  .contact-intro .display-title { font-size: clamp(2.8rem, 6vw, 4.7rem); }
  .contact-first-action { margin-top: 24px; }
  .compare-offers { margin-top: 22px; }
  .hello-dot { color: #ad532f; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: clamp(2.5rem, 6vw, 5rem); padding: 8px 0 64px; align-items: center; }
  .contact-panel { padding: clamp(1.7rem, 3.5vw, 2.5rem); color: var(--ink); background: #f9dfc7; border: 1px solid #e9c9ab; border-radius: 24px; box-shadow: 4px 7px 0 #f0dec957; }
  .inbox-person { display: flex; align-items: center; gap: 13px; margin-bottom: 26px; }
  .inbox-person img { width: 58px; height: 58px; border-radius: 50%; object-fit: cover; }
  .inbox-person h2 { font-family: inherit; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
  .inbox-person p { font-size: 12px; color: var(--muted); margin-top: 5px; }
  .contact-email { font-size: clamp(1rem, 1.6vw, 1.18rem); font-weight: 600; overflow-wrap: anywhere; user-select: all; }
  .copy-email { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; padding: 10px 0; margin-top: 8px; }
  .copy-label { text-decoration: underline; text-underline-offset: 4px; }
  .copy-status { font-size: 11px; min-height: 1.8em; margin-top: 4px; color: #526056; }
  .contact-context h2 { font-size: 1.65rem; }
  .social-profiles { margin-top: 40px; }
  @media (max-width: 800px) {
    .contact-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; padding-bottom: 40px; }
    .contact-panel { max-width: 540px; }
  }
</style>
