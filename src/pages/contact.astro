---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Contact"
  description="Connect with Jacob Huber about software engineering, professional collaboration, websites, or a project you have in mind."
>
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">Get in touch</p>
      <h1 class="display-title">Good things start<br />with a conversation.</h1>
      <p class="lede">
        A website idea, a software challenge, or a professional connection.
        I’d be glad to hear what you’re working on.
      </p>
    </header>

    <section class="contact-grid" aria-label="Ways to connect">
      <div class="contact-panel">
        <p class="eyebrow">A direct line</p>
        <h2>Send me a note.</h2>
        <p>Email is a good place to share an idea and a little context.</p>
        <a class="contact-email" href="mailto:jhuber.mail@icloud.com">
          jhuber.mail@icloud.com <span aria-hidden="true">↗</span>
        </a>
        <div class="contact-location">
          <span class="location-dot" aria-hidden="true"></span>
          Edwardsville, Illinois · St. Louis area
        </div>
      </div>

      <div class="contact-context">
        <div>
          <p class="eyebrow">For a project</p>
          <h2>Tell me what you have in mind.</h2>
          <p class="prose-copy">
            A few details are enough to start: what you’re building, who it’s
            for, your current site or workflow, and any timing you’re working toward.
          </p>
          <a class="text-link" href={withBase('/services/')}>See how I can help <span aria-hidden="true">→</span></a>
        </div>
        <div>
          <p class="eyebrow">For a connection</p>
          <h2>Find me around the web.</h2>
          <p class="prose-copy">
            For engineering conversations and professional connections, you can
            also find my experience on LinkedIn and my public work on GitHub.
          </p>
          <div class="social-links">
            <a class="text-link" href="https://www.linkedin.com/in/jacobhuberonline/">LinkedIn <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="https://github.com/jacobhuberonline">GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(2.5rem, 7vw, 6rem); padding-bottom: 6rem; align-items: start; }
  .contact-panel { padding: clamp(1.75rem, 4vw, 3rem); color: var(--canvas, #f4f3ed); background: var(--forest, #214c3f); border-radius: 4px; }
  .contact-panel .eyebrow { color: var(--accent, #ddea8e); }
  .contact-panel h2 { color: inherit; font-size: clamp(2rem, 3vw, 2.75rem); }
  .contact-panel > p:not(.eyebrow) { max-width: 31ch; margin-top: 1rem; color: #d8dfd3; line-height: 1.75; }
  .contact-email { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: 3rem; padding-block: 1rem; border-top: 1px solid #6f7e6d; border-bottom: 1px solid #6f7e6d; color: #e6efa9; font-size: clamp(0.93rem, 1.8vw, 1.22rem); text-decoration: none; overflow-wrap: anywhere; }
  .contact-email:hover { color: #fff; }
  .contact-panel :focus-visible { outline-color: var(--accent); }
  .contact-location { display: flex; align-items: center; gap: 0.65rem; margin-top: 2rem; color: #d8dfd3; font-size: 0.72rem; }
  .location-dot { flex: 0 0 5px; height: 5px; border-radius: 50%; background: var(--accent, #ddea8e); }
  .contact-context { display: grid; gap: 2.5rem; }
  .contact-context h2 { font-size: 1.7rem; margin-bottom: 1rem; }
  .contact-context .prose-copy { margin-bottom: 1rem; font-size: 0.95rem; }
  .contact-context > div + div { padding-top: 2.5rem; border-top: 1px solid var(--line, #d7ddd1); }
  .social-links { display: flex; flex-wrap: wrap; gap: 1.5rem; }

  @media (max-width: 800px) {
    .contact-grid { grid-template-columns: minmax(0, 1fr); padding-bottom: 4rem; }
    .contact-panel { max-width: 38rem; }
  }
</style>
