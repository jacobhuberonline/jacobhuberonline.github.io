---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ScheduleClient from "../../components/ScheduleClient";
---

<BaseLayout
  title="Baby Schedule"
  description="Live schedule with feeds, naps, play, and bedtime so you always know what the baby should be doing right now and what’s next."
  image="/images/baby-schedule-og.png"
>
  <ScheduleClient client:only="react">
    <div slot="fallback" class="mx-auto max-w-5xl space-y-3">
      <h1 class="text-3xl font-bold">Baby Schedule for Today</h1>
      <p class="text-sm text-muted-foreground" role="status">
        Loading the schedule for your current local time…
      </p>
      <noscript>
        <p class="text-sm text-muted-foreground">
          Enable JavaScript to view the live schedule and choose a schedule stage.
        </p>
      </noscript>
    </div>
  </ScheduleClient>
</BaseLayout>
