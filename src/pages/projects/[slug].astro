---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { projects, type Project } from '../../data/projects';
import { projectStories } from '../../data/project-stories';
import { vestCertificateWorkflow } from '../../data/automation';
import { withBase } from '../../lib/paths';

export function getStaticPaths() {
  return projects.filter((project) => project.caseStudy).map((project) => ({
    params: { slug: project.caseStudy!.slug },
    props: { project },
  }));
}

interface Props { project: Project }
const { project } = Astro.props;
const caseStudy = project.caseStudy!;
const story = projectStories[caseStudy.slug];
const nextProject = projects.find((item) => item.caseStudy && item.caseStudy.slug !== caseStudy.slug);
---

<BaseLayout title={`${project.name}: ${story.isDraft ? 'Draft Project Story' : 'Project Story'}`} description={story.summary} noindex={story.isDraft}>
  <div class="container story-page">
    <header class="page-intro story-intro">
      <nav aria-label="Breadcrumb" class="story-breadcrumbs">
        <a href={withBase('/')}>Home</a><span aria-hidden="true">/</span>
        <a href={withBase('/projects/')}>My work</a><span aria-hidden="true">/</span>
        <span aria-current="page">{project.name}</span>
      </nav>
      <p class="eyebrow">{project.name} · {project.category}</p>
      <h1 class="display-title">{story.title}</h1>
      <p class="lede">{story.summary}</p>
    </header>

    {story.isDraft && <aside id="placeholder-story-notice" class="draft-notice" aria-labelledby="draft-heading">
      <h2 id="draft-heading">Placeholder story</h2>
      <p>The website and screenshot are real. The website challenge, design choices, and outcome below are illustrative draft copy, awaiting the actual project details.</p>
    </aside>}

    <div class="project-overview">
      <dl>
        <div><dt>Project</dt><dd>{project.name}</dd></div>
        <div><dt>Website focus</dt><dd>{project.highlights.join(' · ')}</dd></div>
      </dl>
      {project.url && <a class="text-link" href={project.url}>Visit the live site <Icon name="arrow-up-right" size={18} /></a>}
    </div>

    {caseStudy.slug === 'vest-first-responder' && (
      <aside class="related-automation" aria-labelledby="related-automation-heading">
        <p class="eyebrow">Real client workflow · Beyond the website</p>
        <h2 id="related-automation-heading">Automating certificates after a class.</h2>
        <p>{vestCertificateWorkflow.summary}</p>
        <a class="text-link" href={withBase(vestCertificateWorkflow.href)}>See the certificate workflow <Icon name="arrow-up-right" size={18} /></a>
      </aside>
    )}

    <figure class="story-image">
      <a href={caseStudy.screenshot.src} aria-label={`View full screenshot of ${project.name}`}>
        <Image src={caseStudy.screenshot} alt={caseStudy.screenshotAlt} width={1440} widths={[640, 960, 1440]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1280px) calc(100vw - 96px), 1184px" format="webp" quality={85} loading="lazy" decoding="async" />
      </a>
      <figcaption>A view of the real {project.name} website. <a href={caseStudy.screenshot.src}>Open full screenshot</a></figcaption>
    </figure>

    <div class="story-layout">
      <nav aria-label="In this story" class="story-contents">
        <p class="eyebrow">{story.isDraft ? 'In this draft' : 'In this story'}</p>
        <a href="#challenge">01 · The challenge</a>
        <a href="#decisions">02 · The choices</a>
        <a href="#outcome">03 · What improved</a>
      </nav>
      <article class="story-copy" aria-label={`${project.name} ${story.isDraft ? 'illustrative project story' : 'project story'}`}>
        <section id="challenge" aria-labelledby="challenge-heading">
          <p class="eyebrow">01 / The challenge</p>
          <h2 id="challenge-heading">{story.challenge.title}</h2>
          {story.challenge.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
        <section id="decisions" aria-labelledby="decisions-heading">
          <p class="eyebrow">02 / {story.isDraft ? 'Illustrative choices' : 'The choices'}</p>
          <h2 id="decisions-heading">{story.isDraft ? 'Why take this approach?' : 'What we changed.'}</h2>
          {story.decisions.map((decision) => (
            <div class="design-decision"><h3>{decision.title}</h3><p>{decision.detail}</p></div>
          ))}
        </section>
        <section id="outcome" aria-labelledby="outcome-heading">
          <p class="eyebrow">03 / {story.isDraft ? 'Illustrative outcome' : 'The outcome'}</p>
          <h2 id="outcome-heading">{story.outcome.title}</h2>
          {story.outcome.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>
        {project.testimonial && (
          <figure class="story-testimonial">
            <p class="eyebrow">Client testimonial</p>
            <blockquote><p>“{project.testimonial.storyQuote ?? project.testimonial.quote}”</p></blockquote>
            <figcaption>— {project.testimonial.attribution}</figcaption>
          </figure>
        )}
      </article>
    </div>

    <nav class="more-stories" aria-label="More project stories">
      <a class="text-link" href={withBase('/projects/')}>All projects <Icon name="arrow-up-right" size={18} /></a>
      {nextProject?.caseStudy && <a class="text-link" href={withBase(`/projects/${nextProject.caseStudy.slug}/`)}>Next story: {nextProject.name} <Icon name="arrow-up-right" size={18} /></a>}
    </nav>
  </div>
</BaseLayout>

<style>
  .story-intro { max-width: 980px; padding-bottom: 36px; }
  .story-breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; color: var(--muted); font-size: 12px; }
  .story-breadcrumbs a, figcaption a { text-decoration: underline; text-underline-offset: 4px; }
  .draft-notice { padding: 22px 26px; border: 1px solid #e9c9ab; border-radius: 16px; background: #f9dfc7; }
  .draft-notice h2 { font: 650 16px/1.5 var(--heading-font); letter-spacing: normal; }
  .draft-notice p { margin-top: 6px; font-size: 14px; max-width: 85ch; }
  .project-overview { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; padding: 30px 0; }
  .project-overview dl { display: flex; flex-wrap: wrap; gap: 20px 48px; margin: 0; }
  .project-overview dt { font-size: 12px; color: var(--muted); }
  .project-overview dd { margin: 5px 0 0; font-size: 14px; }
  .related-automation { padding: clamp(22px, 3vw, 32px); margin-bottom: 32px; border: 1px solid var(--line); border-radius: 18px; background: #eef2dc; }
  .related-automation h2 { margin: 10px 0 14px; font-size: clamp(1.6rem, 3vw, 2rem); }
  .related-automation > p:not(.eyebrow) { max-width: 78ch; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .related-automation .text-link { margin-top: 20px; }
  .story-image { margin: 0; }
  .story-image > a { display: block; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; }
  .story-image > a:focus-visible { outline-offset: -5px; }
  .story-image img { width: 100%; height: auto; }
  .story-image figcaption { margin-top: 12px; font-size: 12px; color: var(--muted); }
  .story-layout { display: grid; grid-template-columns: minmax(0, .65fr) minmax(0, 2fr); gap: clamp(32px, 7vw, 90px); padding-top: 64px; }
  .story-contents { align-self: start; display: grid; gap: 14px; position: sticky; top: 125px; font-size: 14px; }
  .story-contents a { width: fit-content; text-decoration: underline; text-underline-offset: 4px; }
  .story-copy { max-width: 760px; }
  .story-copy section + section { margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--line); }
  .story-copy h2 { margin: 12px 0 22px; font-size: clamp(1.9rem, 3.1vw, 2.7rem); }
  .story-copy p:not(.eyebrow) { color: var(--muted); font-size: 16px; line-height: 1.85; }
  .story-copy p + p { margin-top: 18px; }
  .design-decision + .design-decision { margin-top: 28px; }
  .design-decision h3 { margin-bottom: 10px; }
  .story-testimonial { margin: 40px 0 0; padding: 28px; border-left: 3px solid var(--forest); border-radius: 0 16px 16px 0; background: #eef2dc; }
  .story-testimonial blockquote { margin: 14px 0; }
  .story-testimonial figcaption { font-size: 13px; }
  .more-stories { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; margin-top: 64px; padding-top: 28px; border-top: 1px solid var(--line); }
  @media (max-width: 760px) {
    .story-layout { grid-template-columns: minmax(0, 1fr); padding-top: 40px; }
    .story-contents { position: static; }
    .story-intro { padding-top: 40px; }
    .draft-notice { padding: 20px; }
  }
</style>
