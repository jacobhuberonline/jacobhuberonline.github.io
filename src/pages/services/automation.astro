---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ServiceOffers from '../../components/ServiceOffers.astro';
import AutomationDemo from '../../components/AutomationDemo.astro';
import ServiceBreadcrumbs from '../../components/ServiceBreadcrumbs.astro';
import ProjectPlanning from '../../components/ProjectPlanning.astro';
import { formatPrice, serviceOffers } from '../../data/services';
import { withBase } from '../../lib/paths';

const automationOffers = serviceOffers.filter((offer) => offer.id === 'workflow-automation');
const examples = [
  { icon: 'automation', title: 'Data handoffs', detail: 'Move records between existing systems through APIs.' },
  { icon: 'check', title: 'File & data checks', detail: 'Check CSVs, clean up formatting, and flag records that need attention.' },
  { icon: 'tools', title: 'Repeatable reports', detail: 'Turn recurring SQL queries and data exports into reusable scripts.' },
] as const;
---

<BaseLayout
  title="Workflow & Business Process Automation"
  description={`Automate repetitive tasks, data handoffs, and reports. Scripts and integrations from ${formatPrice(automationOffers[0].startingPrice)} for Edwardsville, St. Louis, and nationwide clients.`}
>
  <div class="container service-detail">
    <header class="page-intro">
      <ServiceBreadcrumbs current="Workflow automation" />
      <h1 class="display-title">Workflow automation.<br />Less repeat work.</h1>
      <p class="lede">I build scripts and API integrations that help businesses move data, check files, and cut repeated manual steps.</p>
      <p class="service-area">Based in Edwardsville, Illinois. Working with businesses around St. Louis and across the U.S.</p>
      <div class="button-row detail-actions">
        <a class="button" href={withBase('/contact/?service=workflow-automation')}><Icon name="message" size={20} /> Talk about a repetitive task</a>
        <a class="text-link" href="#automation-demo">Try the sample demo <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </header>

    <AutomationDemo />

    <section class="automation-offer" aria-label="Workflow automation project">
      <ServiceOffers offers={automationOffers} headingLevel="h2" />
      <a class="text-link project-details-link" href={withBase('/services/#project-details')}>Ownership, support & quotes <Icon name="arrow-up-right" size={18} /></a>
    </section>

    <ProjectPlanning projectType="automation" />

    <section class="section" aria-labelledby="automation-examples-heading">
      <div class="section-heading"><h2 id="automation-examples-heading">A few good starting points.</h2></div>
      <div class="automation-examples">
        {examples.map((example) => (
          <article class="surface example">
            <span class="detail-icon"><Icon name={example.icon} /></span>
            <h3>{example.title}</h3>
            <p>{example.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section split-layout" aria-labelledby="automation-experience-heading">
      <h2 id="automation-experience-heading">Built on software experience.</h2>
      <div class="prose-copy">
        <p>My background includes healthcare integrations, custom C#/.NET applications, SQL data work, and PowerShell automation.</p>
        <a class="text-link experience-link" href={withBase('/experience/')}>See my experience <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .service-area { max-width: 58ch; margin-top: 18px; color: var(--muted); font-size: 13px; }
  .detail-actions { margin-top: 1.8rem; }
  .automation-offer { margin-bottom: 3rem; }
  .project-details-link { margin-top: 1.5rem; }
  .automation-examples { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .example:first-child { background: #f1f3e6; }
  .detail-icon { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: 12px; background: var(--accent); margin-bottom: 1.2rem; }
  .example h3 { font-size: 1.4rem; letter-spacing: -0.025em; }
  .example p { color: var(--muted); font-size: 0.95rem; line-height: 1.75; margin-top: 0.6rem; }
  .experience-link { margin-top: 1.4rem; }
  @media (max-width: 760px) {
    .automation-examples { grid-template-columns: 1fr; }
    .automation-offer { margin-bottom: 2rem; }
  }
</style>
