---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ServiceOffers from '../../components/ServiceOffers.astro';
import AutomationDemo from '../../components/AutomationDemo.astro';
import CertificateWorkflow from '../../components/CertificateWorkflow.astro';
import ServiceBreadcrumbs from '../../components/ServiceBreadcrumbs.astro';
import ProjectPlanning from '../../components/ProjectPlanning.astro';
import { formatPrice, serviceOffers } from '../../data/services';
import { withBase } from '../../lib/paths';

const automationOffers = serviceOffers.filter((offer) => offer.id === 'workflow-automation');
const projectStages = [
  { title: 'Plan', detail: 'Agree the inputs, rules, and result.' },
  { title: 'Connect', detail: 'Build around the tools your team uses.' },
  { title: 'Test', detail: 'Check real samples and agreed failure cases.' },
  { title: 'Hand over', detail: 'Provide setup, source files, and operating notes.' },
];
---

<BaseLayout
  title="Workflow & Business Process Automation"
  description={`See how VEST turns training form responses into personalized, emailed certificates. Custom workflow automation from ${formatPrice(automationOffers[0].startingPrice)} for your business.`}
>
  <div class="container service-detail">
    <header class="page-intro">
      <ServiceBreadcrumbs current="Workflow automation" />
      <h1 class="display-title">Workflow automation.<br />Less repeat work.</h1>
      <p class="lede">Connect your tools so recurring paperwork, emails, and data entry take less of your day.</p>
      <p class="service-area">Based in Edwardsville, Illinois. Automation for nearby businesses, the St. Louis area, and teams nationwide.</p>
      <div class="button-row detail-actions">
        <a class="button" href={withBase('/contact/?service=workflow-automation')}><Icon name="message" size={20} /> Talk about a repetitive task</a>
      </div>
    </header>

    <CertificateWorkflow />

    <section class="automation-offer" aria-label="Workflow automation project">
      <div>
        <ServiceOffers offers={automationOffers} headingLevel="h2" />
        <a class="text-link project-details-link" href={withBase('/services/#project-details')}>Ownership, support & quotes <Icon name="arrow-up-right" size={18} /></a>
      </div>
      <div class="project-scope">
        <h2>Built for everyday use.</h2>
        <ol>
          {projectStages.map((stage) => <li><h3>{stage.title}</h3><p>{stage.detail}</p></li>)}
        </ol>
        <p class="meta">Your quote defines the tools, rules, outputs, and exceptions. Extra workflows and paid services are separate.</p>
      </div>
    </section>

    <ProjectPlanning projectType="automation" />

    <details id="automation-demo" class="demo-disclosure">
      <summary>Try the interactive sample <span>Clean up six fictional enquiries</span></summary>
      <AutomationDemo id="automation-demo-content" />
    </details>

    <div class="automation-further">
      <p>Other possibilities: enquiry handoffs, recurring data imports, and monthly reports.</p>
      <a class="text-link" href={withBase('/experience/')}>My software experience <Icon name="arrow-up-right" size={18} /></a>
    </div>

  </div>
</BaseLayout>

<script>
  const demo = document.querySelector<HTMLDetailsElement>('#automation-demo');
  const openLinkedDemo = () => {
    if (demo && window.location.hash === '#automation-demo') demo.open = true;
  };
  openLinkedDemo();
  window.addEventListener('hashchange', openLinkedDemo);
</script>

<style>
  .service-area { max-width: 58ch; margin-top: 18px; color: var(--muted); font-size: 13px; }
  .detail-actions { margin-top: 1.8rem; }
  .automation-offer { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; margin-bottom: 3rem; }
  .project-scope { padding-top: 12px; }
  .project-scope h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 18px; }
  .project-scope p { color: var(--muted); font-size: 15px; line-height: 1.8; }
  .project-scope ol { list-style: decimal; padding-left: 22px; margin: 24px 0; }
  .project-scope li { padding-left: 4px; }
  .project-scope li + li { margin-top: 16px; }
  .project-scope h3 { font-size: 17px; margin-bottom: 6px; }
  .project-scope .meta { font-size: 13px; }
  .project-details-link { margin-top: 1.5rem; }
  .demo-disclosure { border: 1px solid var(--line); border-radius: 20px; background: var(--paper); overflow: hidden; }
  .demo-disclosure > summary { padding: 24px; font-weight: 600; }
  .demo-disclosure > summary span { display: block; margin-top: 6px; color: var(--muted); font-size: 14px; font-weight: 400; }
  .demo-disclosure > summary:focus-visible { outline-offset: -5px; }
  .demo-disclosure :global(.automation-demo) { margin: 0; border: 0; border-top: 1px solid var(--line); border-radius: 0; }
  .automation-further { display: flex; align-items: start; justify-content: space-between; gap: 24px; margin-top: 28px; }
  .automation-further p { max-width: 55ch; color: var(--muted); font-size: 14px; }
  .automation-further .text-link { flex-shrink: 0; }
  @media (max-width: 760px) {
    .automation-offer { grid-template-columns: minmax(0, 1fr); margin-bottom: 2rem; }
    .automation-further { flex-direction: column; }
  }
</style>
