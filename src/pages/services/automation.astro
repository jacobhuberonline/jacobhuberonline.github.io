---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ServiceOffers from '../../components/ServiceOffers.astro';
import AutomationDemo from '../../components/AutomationDemo.astro';
import CertificateWorkflow from '../../components/CertificateWorkflow.astro';
import ServiceBreadcrumbs from '../../components/ServiceBreadcrumbs.astro';
import ProjectPlanning from '../../components/ProjectPlanning.astro';
import { formatPrice, serviceOffers } from '../../data/services';
import { withBase } from '../../lib/paths';

const automationOffers = serviceOffers.filter((offer) => offer.id === 'workflow-automation');
const examples = [
  { icon: 'automation', title: 'Enquiry handoffs', detail: 'Take a new enquiry, record the details in your existing system, and notify the person who needs to follow up.' },
  { icon: 'check', title: 'Regular data imports', detail: 'Check a recurring export, flag incomplete records, and prepare the valid rows for the next system.' },
  { icon: 'tools', title: 'Monthly reports', detail: 'Bring together routine data exports, produce an agreed report, and send it to the people who need it.' },
] as const;
const projectStages = [
  { title: 'Map the workflow', detail: 'Agree where the data comes from, the rules to apply, and the result your team needs.' },
  { title: 'Connect the steps', detail: 'Build the script or integration around your tools, including the agreed document or email output.' },
  { title: 'Test the real situations', detail: 'Check sample inputs, expected results, and agreed failure cases before putting it into use.' },
  { title: 'Hand it over clearly', detail: 'Provide setup, source files, and operating notes so you know how the workflow runs and what needs attention.' },
];
---

<BaseLayout
  title="Workflow & Business Process Automation"
  description={`See how VEST turns training form responses into personalized, emailed certificates. Custom workflow automation from ${formatPrice(automationOffers[0].startingPrice)} for your business.`}
>
  <div class="container service-detail">
    <header class="page-intro">
      <ServiceBreadcrumbs current="Workflow automation" />
      <h1 class="display-title">Workflow automation.<br />Less repeat work.</h1>
      <p class="lede">Turn recurring admin into a connected process: collect the details, create the document, and get it to the right person. I build the scripts and integrations around your business.</p>
      <p class="service-area">Based in Edwardsville, Illinois. Working with businesses around St. Louis and across the U.S.</p>
      <div class="button-row detail-actions">
        <a class="button" href={withBase('/contact/?service=workflow-automation')}><Icon name="message" size={20} /> Talk about a repetitive task</a>
        <a class="text-link" href="#vest-certificates">See the VEST certificate workflow <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </header>

    <CertificateWorkflow />

    <section class="automation-offer" aria-label="Workflow automation project">
      <div>
        <ServiceOffers offers={automationOffers} headingLevel="h2" />
        <a class="text-link project-details-link" href={withBase('/services/#project-details')}>Ownership, support & quotes <Icon name="arrow-up-right" size={18} /></a>
      </div>
      <div class="project-scope">
        <h2>What goes into your workflow project.</h2>
        <p>The starting scope covers designing, building, testing, and setting up one agreed workflow for repeated use in your business.</p>
        <ol>
          {projectStages.map((stage) => <li><h3>{stage.title}</h3><p>{stage.detail}</p></li>)}
        </ol>
        <p class="meta">The quote confirms which tools, rules, outputs, and exception cases are included. Extra workflows, paid services, and ongoing monitoring or support are quoted separately.</p>
      </div>
    </section>

    <ProjectPlanning projectType="automation" />

    <AutomationDemo />

    <section class="section" aria-labelledby="automation-examples-heading">
      <div class="section-heading"><h2 id="automation-examples-heading">Other tasks we could connect.</h2></div>
      <div class="automation-examples">
        {examples.map((example) => (
          <article class="surface example">
            <span class="detail-icon"><Icon name={example.icon} /></span>
            <h3>{example.title}</h3>
            <p>{example.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section split-layout" aria-labelledby="automation-experience-heading">
      <h2 id="automation-experience-heading">Built on software experience.</h2>
      <div class="prose-copy">
        <p>My background includes healthcare integrations, custom C#/.NET applications, SQL data work, and PowerShell automation.</p>
        <a class="text-link experience-link" href={withBase('/experience/')}>See my experience <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .service-area { max-width: 58ch; margin-top: 18px; color: var(--muted); font-size: 13px; }
  .detail-actions { margin-top: 1.8rem; }
  .automation-offer { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; margin-bottom: 3rem; }
  .project-scope { padding-top: 12px; }
  .project-scope h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); margin-bottom: 18px; }
  .project-scope p { color: var(--muted); font-size: 15px; line-height: 1.8; }
  .project-scope ol { list-style: decimal; padding-left: 22px; margin: 24px 0; }
  .project-scope li { padding-left: 4px; }
  .project-scope li + li { margin-top: 20px; }
  .project-scope h3 { font-size: 17px; margin-bottom: 6px; }
  .project-scope .meta { font-size: 13px; }
  .project-details-link { margin-top: 1.5rem; }
  .automation-examples { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .example:first-child { background: #f1f3e6; }
  .detail-icon { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: 12px; background: var(--accent); margin-bottom: 1.2rem; }
  .example h3 { font-size: 1.4rem; letter-spacing: -0.025em; }
  .example p { color: var(--muted); font-size: 0.95rem; line-height: 1.75; margin-top: 0.6rem; }
  .experience-link { margin-top: 1.4rem; }
  @media (max-width: 760px) {
    .automation-examples { grid-template-columns: 1fr; }
    .automation-offer { grid-template-columns: minmax(0, 1fr); margin-bottom: 2rem; }
  }
</style>
