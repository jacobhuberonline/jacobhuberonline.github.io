---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ServiceOffers from '../../components/ServiceOffers.astro';
import WebsiteCare from '../../components/WebsiteCare.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import { serviceOffers } from '../../data/services';
import { withBase } from '../../lib/paths';

const websiteOffers = serviceOffers.filter((offer) =>
  offer.id === 'starter-website' || offer.id === 'business-website'
);
---

<BaseLayout
  title="Business Website Design & Redesign"
  description="Business websites and redesigns by Jacob Huber, with optional managed hosting, maintenance, and content updates after launch."
>
  <div class="container service-detail">
    <header class="page-intro">
      <p class="eyebrow"><a href={withBase('/services/')}>Services</a> <span aria-hidden="true">/</span> Websites</p>
      <h1 class="display-title">Websites & redesigns<br />for small businesses.</h1>
      <p class="lede">I build clear, mobile-friendly business websites and refresh older ones. With website care, I handle the hosting and updates after launch, too.</p>
      <div class="button-row detail-actions">
        <a class="button" href={withBase('/contact/')}><Icon name="message" size={20} /> Get a project estimate</a>
        <a class="text-link" href={withBase('/projects/')}>See my work <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </header>

    <section class="offerings" aria-label="Website project options">
      <ServiceOffers offers={websiteOffers} headingLevel="h2" />
      <a class="text-link project-details-link" href={withBase('/services/#project-details')}>Ownership, support & quotes <Icon name="arrow-up-right" size={18} /></a>
    </section>

    <WebsiteCare />

    <section class="section" aria-labelledby="website-examples-heading">
      <div class="section-heading"><h2 id="website-examples-heading">A couple I’ve built.</h2></div>
      <div class="project-grid">
        {projects.slice(0, 2).map((project) => <ProjectCard project={project} headingLevel="h3" featured />)}
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .page-intro .eyebrow a { text-decoration: underline; text-underline-offset: 4px; }
  .page-intro .eyebrow > span { margin-inline: 0.6rem; }
  .detail-actions { margin-top: 1.8rem; }
  .offerings { margin-bottom: 3rem; }
  .project-details-link { margin-top: 1.5rem; }
  @media (max-width: 760px) {
    .offerings { margin-bottom: 2rem; }
  }
</style>
