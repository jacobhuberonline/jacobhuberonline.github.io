---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { withBase } from '../../lib/paths';

const options = [
  { icon: 'website', title: 'New websites', detail: 'A home for your business, services, and work.' },
  { icon: 'refresh', title: 'Website redesigns', detail: 'Refresh an older site’s content, layout, and navigation.' },
  { icon: 'message', title: 'Landing pages', detail: 'One focused page for a service, event, or new offering.' },
] as const;
const questions = [
  { question: 'Can you redesign my current site?', answer: 'Yes. We can keep the useful parts and work out which pages, content, and features need to change.' },
  { question: 'Can I start with one page?', answer: 'Yes. A landing page is a useful starting point when you have one thing to explain or share.' },
  { question: 'What do you need to get started?', answer: 'Your business, the site’s goal, and a link to your current site if you have one.' },
];
---

<BaseLayout
  title="Business Website Design & Redesign"
  description="Business websites and redesigns by Jacob Huber: clear service pages, mobile-friendly layouts, and easy ways to get in touch."
>
  <div class="container service-detail">
    <header class="page-intro">
      <p class="eyebrow"><a href={withBase('/services/')}>Services</a> <span aria-hidden="true">/</span> Websites</p>
      <h1 class="display-title">Websites & redesigns<br />for small businesses.</h1>
      <p class="lede">I build new business websites and refresh older ones, with clear pages, mobile-friendly layouts, and an easy way to get in touch.</p>
      <div class="button-row detail-actions">
        <a class="button" href={withBase('/contact/')}><Icon name="message" size={20} /> Start a project</a>
        <a class="text-link" href={withBase('/projects/')}>See my work <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </header>

    <section class="offerings" aria-label="Website services">
      {options.map((option) => (
        <article class="surface offering">
          <span class="detail-icon"><Icon name={option.icon} /></span>
          <h2>{option.title}</h2>
          <p>{option.detail}</p>
        </article>
      ))}
    </section>

    <section class="section" aria-labelledby="website-examples-heading">
      <div class="section-heading"><h2 id="website-examples-heading">A couple I’ve built.</h2></div>
      <div class="examples">
        <a class="surface example-link" href="https://www.krhdesignco.com">
          <div><h3>KRH Design Co.</h3><p>Interior design work, services, and consultation requests.</p></div>
          <Icon name="arrow-up-right" />
        </a>
        <a class="surface example-link" href="https://www.vestfirstresponder.com">
          <div><h3>VEST First Responder</h3><p>Training courses, resources, and class requests.</p></div>
          <Icon name="arrow-up-right" />
        </a>
      </div>
    </section>

    <section class="section" aria-labelledby="website-questions-heading">
      <div class="section-heading"><h2 id="website-questions-heading">Good to know.</h2></div>
      <div class="service-questions">
        {questions.map((item) => (
          <details><summary>{item.question}</summary><p>{item.answer}</p></details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-intro .eyebrow a { text-decoration: underline; text-underline-offset: 4px; }
  .page-intro .eyebrow > span { margin-inline: 0.6rem; }
  .detail-actions { margin-top: 1.8rem; }
  .offerings { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; margin-bottom: 3rem; }
  .offering:first-child { background: #f9dfc7; border-color: #e9c9ab; }
  .detail-icon { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: 12px; background: var(--peach); margin-bottom: 1.2rem; }
  .offering:first-child .detail-icon { background: var(--paper); }
  .offering h2 { font-size: 1.4rem; letter-spacing: -0.025em; }
  .offering p, .example-link p { color: var(--muted); font-size: 0.95rem; line-height: 1.75; margin-top: 0.6rem; }
  .examples { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; }
  .example-link { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .example-link:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
  .service-questions { max-width: 860px; }
  .service-questions details { padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .service-questions summary { font-size: 1rem; font-weight: 600; }
  .service-questions p { color: var(--muted); line-height: 1.75; margin-top: 0.75rem; max-width: 65ch; }
  @media (max-width: 760px) {
    .offerings, .examples { grid-template-columns: 1fr; }
    .offerings { margin-bottom: 2rem; }
  }
</style>
