---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ServiceOffers from '../../components/ServiceOffers.astro';
import WebsiteCare from '../../components/WebsiteCare.astro';
import ServiceBreadcrumbs from '../../components/ServiceBreadcrumbs.astro';
import ProjectPlanning from '../../components/ProjectPlanning.astro';
import { projects } from '../../data/projects';
import { projectStories } from '../../data/project-stories';
import { formatPrice, serviceOffers, websiteCare } from '../../data/services';
import { withBase } from '../../lib/paths';

const websiteOffers = serviceOffers.filter((offer) =>
  offer.id === 'starter-website' || offer.id === 'business-website'
);
---

<BaseLayout
  title="Small Business Website Design & Redesign"
  description={`Website design for Edwardsville, St. Louis, and U.S. businesses. Projects from ${formatPrice(websiteOffers[0].startingPrice)}, with optional hosting and updates from ${formatPrice(websiteCare.monthlyPrice)}/month.`}
>
  <div class="container service-detail">
    <header class="page-intro">
      <ServiceBreadcrumbs current="Business websites" />
      <h1 class="display-title">Websites & redesigns<br />for small businesses.</h1>
      <p class="lede">Clear, mobile-friendly websites that make your business easy to understand and contact.</p>
      <p class="service-area">Edwardsville, Illinois · St. Louis & nationwide</p>
      <div class="button-row detail-actions">
        <a class="button" href={withBase('/contact/')}><Icon name="message" size={20} /> Get a project estimate</a>
        <a class="text-link" href="#website-options">Compare website options <Icon name="arrow-up-right" size={18} /></a>
      </div>
    </header>

    <section id="website-options" class="offerings" aria-label="Website project options">
      <ServiceOffers offers={websiteOffers} headingLevel="h2" />
      <a class="text-link project-details-link" href={withBase('/services/#project-details')}>Ownership, support & quotes <Icon name="arrow-up-right" size={18} /></a>
    </section>

    <ProjectPlanning projectType="website" />

    <section class="section" aria-labelledby="website-examples-heading">
      <div class="section-heading">
        <h2 id="website-examples-heading">The thinking behind the design.</h2>
      </div>
      <div class="story-references">
        {projects.slice(0, 2).map((project) => project.caseStudy && (
          <article class="story-reference">
            <p class="eyebrow">{project.category} · Placeholder story</p>
            <h3>{project.name}</h3>
            <p>{projectStories[project.caseStudy.slug].serviceTakeaway}</p>
            <a class="text-link" href={withBase(`/projects/${project.caseStudy.slug}/#decisions`)} aria-label={`Explore draft design choices: ${project.name}`}>Explore the design choices <Icon name="arrow-up-right" size={18} /></a>
          </article>
        ))}
      </div>
    </section>

    <WebsiteCare />

  </div>
</BaseLayout>

<style>
  .service-area { max-width: 58ch; margin-top: 18px; color: var(--muted); font-size: 13px; }
  .detail-actions { margin-top: 1.8rem; }
  .offerings { margin-bottom: 3rem; }
  .project-details-link { margin-top: 1.5rem; }
  .story-references { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .story-reference { border-top: 2px solid var(--forest); padding-top: 24px; }
  .story-reference h3 { font-size: 1.5rem; margin: 12px 0; }
  .story-reference > p:not(.eyebrow) { max-width: 52ch; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .story-reference .text-link { margin-top: 24px; }
  @media (max-width: 760px) {
    .offerings { margin-bottom: 2rem; }
    .story-references { grid-template-columns: minmax(0, 1fr); }
  }
</style>
