---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aiWorkflows, education, experience, skillGroups } from '../data/profile';
---

<BaseLayout
  title="Experience"
  description="Jacob Huber's experience in software engineering, healthcare integrations, technical support, and people leadership."
>
  <div class="container">
    <div class="resume-print-header">
      <p class="resume-name">Jacob Huber</p>
      <p>Software Engineer · Edwardsville, Illinois</p>
      <p>jhuber.mail@icloud.com · linkedin.com/in/jacobhuberonline</p>
    </div>
    <header class="page-intro">
      <h1 class="display-title">The road so far.</h1>
      <p class="lede">
        I started in restaurants, moved into healthcare technology, and now build
        software at symplr. Here's what I've worked on along the way.
      </p>
      <button class="button button-secondary print-hide" type="button" id="print-resume">Print résumé <span aria-hidden="true">↗</span></button>
    </header>

    <section class="section" aria-labelledby="career-heading">
      <h2 id="career-heading" class="section-heading">Where I've worked.</h2>
      <ol class="timeline">
        {experience.map((position) => (
          <li class="timeline-item">
            <div class="timeline-date">
              <p>{position.period}</p>
              <p class="meta">{position.location}</p>
            </div>
            <article class="timeline-body">
              <p class="company-name">{position.company}</p>
              <h3>{position.role}</h3>
              <p class="role-summary">{position.summary}</p>
              <ul class="experience-highlights">
                {position.highlights.map((highlight) => <li>{highlight}</li>)}
              </ul>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section class="section split-layout" aria-labelledby="skills-heading">
      <div>
        <h2 id="skills-heading" class="section-heading">What I work with.</h2>
        <p class="prose-copy">The languages, tools, and skills I use to build software and help people use it.</p>
      </div>
      <div class="skill-groups">
        {skillGroups.map((group) => (
          <section aria-label={group.title}>
            <h3>{group.title}</h3>
            <ul class="tag-list">
              {group.items.map((skill) => <li class="tag">{skill}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </section>

    <section class="section split-layout" aria-labelledby="ai-heading">
      <div>
        <h2 id="ai-heading" class="section-heading">AI in my toolbox.</h2>
        <p class="prose-copy">Coding assistants are part of how I build, learn, and help other developers. Here’s where each one fits.</p>
      </div>
      <div class="ai-workflows">
        {aiWorkflows.map((workflow) => (
          <article class="ai-workflow">
            <p class="meta">{workflow.context}</p>
            <h3>{workflow.tool}</h3>
            <p class="prose-copy">{workflow.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section split-layout" aria-labelledby="education-heading">
      <div>
        <h2 id="education-heading" class="section-heading">Where I studied.</h2>
      </div>
      <ul class="rule-list education-list">
        {education.map((entry) => (
          <li>
            <p class="meta">{entry.institution} · {entry.year}</p>
            <h3>{entry.qualification}</h3>
            {entry.detail && <p>{entry.detail}</p>}
          </li>
        ))}
      </ul>
    </section>

  </div>
</BaseLayout>

<script>
  document.getElementById('print-resume')?.addEventListener('click', () => window.print());
</script>

<style>
  .resume-print-header { display: none; }
  #print-resume { margin-top: 1.5rem; }
  .timeline-date p { margin: 0 0 0.5rem; }
  .timeline-body .company-name { margin: 0 0 0.5rem; font-weight: 600; color: var(--forest); }
  .timeline-body h3 { margin: 0 0 1rem; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .role-summary { margin: 0 0 1.25rem; font-weight: 500; }
  .experience-highlights { margin: 0; padding-left: 1.15rem; list-style: disc; }
  .experience-highlights li + li { margin-top: 0.75rem; }
  .skill-groups { display: grid; gap: 2rem; }
  .skill-groups h3 { margin: 0 0 0.9rem; font-size: 1.25rem; }
  .education-list h3 { margin: 0.6rem 0; font-size: 1.4rem; }
  .education-list p { margin: 0; }
  .ai-workflows { display: grid; gap: 1.25rem; }
  .ai-workflow { padding: 1.5rem; border: 1px solid var(--line); border-radius: 16px; background: var(--paper); break-inside: avoid; }
  .ai-workflow:last-child { background: #f1f3e6; }
  .ai-workflow h3 { margin: 0.35rem 0 0.85rem; font-size: 1.3rem; }
  .ai-workflow .prose-copy { font-size: 0.95rem; }
  @media print {
    .resume-print-header { display: block; margin-bottom: 1.5rem; }
    .resume-print-header p { margin: 0.25rem 0; font-size: 0.85rem; }
    .resume-print-header .resume-name { margin: 0 0 0.5rem; font-size: 2rem; font-weight: 600; }
    .page-intro { display: none; }
  }
</style>
