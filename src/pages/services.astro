---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/paths';

const websiteOptions = [
  { icon: 'website', title: 'New website', detail: 'Your business, services, and work in one place.' },
  { icon: 'refresh', title: 'Website refresh', detail: 'Update an older site to fit where you are now.' },
  { icon: 'message', title: 'Landing page', detail: 'One focused page for a service or event.' },
] as const;
const supportingServices = [
  { id: 'tools', icon: 'tools', title: 'Small web tools', detail: 'Dashboards, reporting tools, and apps for checking or organizing your data.' },
  { id: 'automation', icon: 'automation', title: 'Less busywork', detail: 'Connect your apps and turn repeated tasks into scripts.' },
] as const;
const steps = [
  { icon: 'message', title: 'Talk', detail: 'Share your idea and what the site should do.' },
  { icon: 'check', title: 'Plan', detail: 'Agree on the pages and features.' },
  { icon: 'tools', title: 'Build & review', detail: 'Try it out and share feedback before it goes live.' },
] as const;
---

<BaseLayout
  title="Services"
  description="New business websites, website refreshes, and useful software tools by Jacob Huber."
>
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">Services</p>
      <h1 class="display-title">A website you’re<br />glad to share.</h1>
      <p class="lede">New websites and fresh starts for small businesses, creatives, and local organizations.</p>
      <div class="service-actions">
        <a class="button" href={withBase('/contact/')}><Icon name="message" /> Start a project</a>
        <a class="text-link" href={withBase('/projects/')}>See my work <Icon name="arrow-up-right" /></a>
      </div>
    </header>

    <section id="service-websites" class="website-service" aria-labelledby="website-heading">
      <div class="website-description">
        <span class="service-symbol"><Icon name="website" /></span>
        <h2 id="website-heading">Websites for your business.</h2>
        <p>Show what you do, share your work, and give people an easy way to reach you.</p>
      </div>
      <div class="website-options">
        {websiteOptions.map((option) => (
          <div class="website-option">
            <span class="option-icon"><Icon name={option.icon} /></span>
            <div><h3>{option.title}</h3><p>{option.detail}</p></div>
          </div>
        ))}
      </div>
    </section>

    <section class="website-proof" aria-labelledby="website-proof-heading">
      <h2 id="website-proof-heading">A couple I’ve built.</h2>
      <div class="proof-links">
        <a href="https://www.krhdesignco.com">
          <div><h3>KRH Design Co.</h3><p>Interior design</p></div>
          <span class="proof-arrow"><Icon name="arrow-up-right" /></span>
        </a>
        <a href="https://www.vestfirstresponder.com">
          <div><h3>VEST First Responder</h3><p>First-responder training</p></div>
          <span class="proof-arrow"><Icon name="arrow-up-right" /></span>
        </a>
      </div>
    </section>

    <section class="section project-process" aria-labelledby="process-heading">
      <div class="section-heading"><h2 id="process-heading">How we’ll work together.</h2></div>
      <div class="process-steps">
        {steps.map((step) => (
          <div>
            <span class="process-icon"><Icon name={step.icon} /></span>
            <h3>{step.title}</h3><p>{step.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section extra-help" aria-labelledby="extra-help-heading">
      <div class="section-heading"><h2 id="extra-help-heading">Beyond the website.</h2></div>
      <div class="supporting-services">
        {supportingServices.map((service) => (
          <section id={`service-${service.id}`} class="service-card" aria-labelledby={`${service.id}-heading`}>
            <span class="service-symbol"><Icon name={service.icon} /></span>
            <h3 id={`${service.id}-heading`}>{service.title}</h3>
            <p>{service.detail}</p>
          </section>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .service-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: 2rem; }
  .website-service { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid #e9c9ab; border-radius: 20px; background: #f9dfc7; }
  .service-symbol { display: inline-flex; width: 3rem; height: 3rem; align-items: center; justify-content: center; border-radius: 12px; background: var(--peach); color: var(--ink); }
  .website-service .service-symbol { background: var(--paper); }
  .website-description h2 { max-width: 20ch; font-size: clamp(1.9rem, 3vw, 2.65rem); margin: 1.2rem 0 1rem; }
  .website-description > p { max-width: 39ch; color: var(--muted); font-size: 1rem; line-height: 1.8; }
  .website-options { display: grid; gap: 1.6rem; }
  .website-option { display: flex; align-items: start; gap: 1rem; }
  .option-icon { display: grid; place-items: center; flex: 0 0 2rem; height: 2rem; color: var(--forest); }
  .website-options h3 { font-size: 1.05rem; }
  .website-options p { margin-top: 0.4rem; color: var(--muted); font-size: 0.95rem; line-height: 1.7; }
  .website-proof { padding-block: 2.5rem 3.5rem; }
  .website-proof h2 { font-size: 1.2rem; letter-spacing: -0.02em; }
  .proof-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; margin-top: 1rem; }
  .proof-links a { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; border-bottom: 1px solid var(--line); padding: 1rem 0; }
  .proof-links a:hover h3 { color: var(--forest); text-decoration: underline; text-underline-offset: 4px; }
  .proof-links h3 { font-size: 1rem; }
  .proof-links p { margin-top: 0.35rem; font-size: 0.86rem; color: var(--muted); }
  .proof-arrow { flex: 0 0 2rem; display: grid; height: 2rem; place-items: center; border-radius: 50%; background: var(--accent); }
  .process-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  .process-icon { display: grid; width: 2.75rem; height: 2.75rem; place-items: center; border-radius: 50%; background: var(--accent); margin-bottom: 1rem; }
  .process-steps h3 { margin-bottom: 0.6rem; }
  .process-steps p { max-width: 29ch; color: var(--muted); font-size: 0.95rem; line-height: 1.8; }
  .supporting-services { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .service-card { padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--line); border-radius: 20px; background: var(--paper); }
  .service-card:nth-child(2) { background: #f1f3e6; }
  .service-card:nth-child(2) .service-symbol { background: var(--accent); }
  .service-card h3 { margin: 1.2rem 0 0.8rem; font-size: 1.55rem; }
  .service-card > p { color: var(--muted); font-size: 0.95rem; line-height: 1.8; }

  @media (max-width: 720px) {
    .website-service, .proof-links, .process-steps, .supporting-services { grid-template-columns: minmax(0, 1fr); }
    .website-service { gap: 1.75rem; }
    .website-description h2 { max-width: 22ch; }
    .proof-links { gap: 0.5rem; }
    .website-proof { padding-block: 2rem; }
    .process-steps { gap: 1.5rem; }
  }
</style>
