---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

const websiteOptions = [
  { title: 'A new website', detail: 'A home for your business, services, or creative work, with the pages people need to get to know you.' },
  { title: 'A fresh start', detail: 'An update to an older site that no longer looks, reads, or works the way you want it to.' },
  { title: 'A focused page', detail: 'A place to explain a particular service, share an event, or introduce something new.' },
];
const supportingServices = [
  {
    id: 'tools',
    symbol: '⌘',
    title: 'A tool that fits the job.',
    description: 'Need more than a website? I also build small apps around the way you work: a place to collect reports, a dashboard to see what’s happening, or a tool to check a file before you use it.',
    examples: ['Simple dashboards and internal apps', 'Tools for checking and exporting data'],
  },
  {
    id: 'automation',
    symbol: '↻',
    title: 'Less busywork.',
    description: 'If you keep copying information between systems or repeating the same steps, there may be a better way. I connect software and write scripts to help with those recurring jobs.',
    examples: ['Move information between apps', 'Turn a repeated task into a script'],
  },
];
const steps = [
  { title: 'Tell me about it.', detail: 'Share what you do, what you want your site to help with, and a link to the current one if you have it.' },
  { title: 'Decide what belongs.', detail: 'We’ll talk through the pages, content, and features, then agree on what to build.' },
  { title: 'Build it and try it.', detail: 'You’ll have a chance to look it over and share feedback before it goes live.' },
];
---

<BaseLayout
  title="Services"
  description="New websites, thoughtful redesigns, and useful web tools for small businesses and local organizations. Start a project with Jacob Huber."
>
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">Websites & a little more</p>
      <h1 class="display-title">A website you’re<br />glad to share.</h1>
      <p class="lede">
        I build websites for small businesses, independent creatives, and local
        organizations. Starting from scratch or giving an older site a fresh
        start, we can make it feel like you—and make it easy for people to get in touch.
      </p>
      <div class="service-actions">
        <a class="button" href={withBase('/contact/')}>Start a project <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={withBase('/projects/')}>See my work <span aria-hidden="true">→</span></a>
      </div>
    </header>

    <section id="service-websites" class="website-service" aria-labelledby="website-heading">
      <div class="website-description">
        <span class="service-symbol" aria-hidden="true">↗</span>
        <h2 id="website-heading">A website that feels like you.</h2>
        <p>
          Your site should explain what you do, show the work you’re proud of,
          and help someone take the next step. I help put those pieces together,
          with clear pages and layouts that work on phones too.
        </p>
        <p class="website-fit">
          A good fit if you want a useful business site, a place to share your
          work, or a clearer way to explain a service.
        </p>
      </div>
      <div class="website-options">
        {websiteOptions.map((option) => (
          <div>
            <h3>{option.title}</h3>
            <p>{option.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="website-proof" aria-labelledby="website-proof-heading">
      <h2 id="website-proof-heading">Here’s what that can look like.</h2>
      <div class="proof-links">
        <a href="https://www.krhdesignco.com">
          <div><h3>KRH Design Co.</h3><p>A home for an interior designer’s work, services, and consultation requests.</p></div>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://www.vestfirstresponder.com">
          <div><h3>VEST First Responder</h3><p>Courses, resources, and a way for first-responder teams to request training.</p></div>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="section project-process" aria-labelledby="process-heading">
      <div class="section-heading">
        <div><p class="eyebrow">Working together</p><h2 id="process-heading">A simple place to start.</h2></div>
        <p>You don’t need a finished plan. We can work through the details together.</p>
      </div>
      <div class="process-steps">
        {steps.map((step) => (
          <div><h3>{step.title}</h3><p>{step.detail}</p></div>
        ))}
      </div>
      <a class="button" href={withBase('/contact/')}>Start a project <span aria-hidden="true">↗</span></a>
    </section>

    <section class="section extra-help" aria-labelledby="extra-help-heading">
      <div class="section-heading">
        <div><p class="eyebrow">Beyond the website</p><h2 id="extra-help-heading">A little help behind the scenes.</h2></div>
        <p>My software engineering background comes in handy when you need a tool or two as well.</p>
      </div>
      <div class="supporting-services">
        {supportingServices.map((service) => (
          <section id={`service-${service.id}`} class="service-card" aria-labelledby={`${service.id}-heading`}>
            <span class="service-symbol" aria-hidden="true">{service.symbol}</span>
            <h3 id={`${service.id}-heading`}>{service.title}</h3>
            <p>{service.description}</p>
            <ul class="service-examples">
              {service.examples.map((example) => <li>{example}</li>)}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .service-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: 2rem; }
  .website-service { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid #e9c9ab; border-radius: 20px; background: #f9dfc7; }
  .service-symbol { display: inline-flex; width: 3rem; height: 3rem; align-items: center; justify-content: center; border-radius: 12px; background: var(--peach); color: var(--ink); font-size: 1.7rem; line-height: 1; }
  .website-service .service-symbol { background: var(--paper); }
  .website-description h2 { max-width: 20ch; font-size: clamp(1.9rem, 3vw, 2.65rem); margin: 1.2rem 0 1rem; }
  .website-description > p { color: var(--muted); font-size: 1rem; line-height: 1.8; }
  .website-description .website-fit { margin-top: 1rem; font-size: 0.9rem; }
  .website-options { display: grid; gap: 1.6rem; }
  .website-options h3 { font-size: 1.05rem; }
  .website-options p { margin-top: 0.5rem; color: var(--muted); font-size: 0.95rem; line-height: 1.7; }
  .website-proof { padding-block: 2.5rem 3.5rem; }
  .website-proof h2 { font-size: 1.2rem; letter-spacing: -0.02em; }
  .proof-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; margin-top: 1rem; }
  .proof-links a { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; border-bottom: 1px solid var(--line); padding: 1rem 0; }
  .proof-links a:hover h3 { color: var(--forest); text-decoration: underline; text-underline-offset: 4px; }
  .proof-links h3 { font-size: 1rem; }
  .proof-links p { margin-top: 0.5rem; font-size: 0.86rem; color: var(--muted); line-height: 1.7; }
  .proof-links a > span { flex: 0 0 2rem; display: grid; height: 2rem; place-items: center; border-radius: 50%; background: var(--accent); }
  .process-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-bottom: 2rem; }
  .process-steps h3 { margin-bottom: 0.8rem; }
  .process-steps p { color: var(--muted); font-size: 0.95rem; line-height: 1.8; }
  .supporting-services { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .service-card { padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--line); border-radius: 20px; background: var(--paper); }
  .service-card:nth-child(2) { background: #f1f3e6; }
  .service-card:nth-child(2) .service-symbol { background: var(--accent); }
  .service-card h3 { margin: 1.3rem 0 1rem; font-size: 1.55rem; }
  .service-card > p { color: var(--muted); font-size: 0.95rem; line-height: 1.8; }
  .service-examples { display: grid; gap: 0.6rem; margin: 1.5rem 0 0; padding: 0; list-style: none; }
  .service-examples li { display: flex; align-items: baseline; gap: 0.8rem; color: var(--muted); font-size: 0.88rem; line-height: 1.6; }
  .service-examples li::before { content: '✓'; flex-shrink: 0; color: var(--forest); font-size: 0.9rem; }

  @media (max-width: 720px) {
    .website-service, .proof-links, .process-steps, .supporting-services { grid-template-columns: minmax(0, 1fr); }
    .website-service { gap: 1.75rem; }
    .website-description h2 { max-width: 22ch; }
    .proof-links { gap: 0.5rem; }
    .website-proof { padding-block: 2rem; }
    .process-steps { gap: 1.5rem; }
  }
</style>
