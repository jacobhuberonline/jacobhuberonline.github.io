---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';

const services = [
  {
    id: 'websites',
    symbol: '↗',
    title: 'A website that feels like you.',
    description: 'Starting something new, or ready to give an older site some attention? I can help you make a site that explains what you do, shows your work, and feels good to use on a phone.',
    examples: ['A home for your business or creative work', 'A page for a service, event, or new idea', 'An easier way for people to find the details they need'],
  },
  {
    id: 'tools',
    symbol: '⌘',
    title: 'A tool that fits the job.',
    description: 'Sometimes you need a bit of software built around what you actually do. That might be a place to collect reports, a dashboard to see what’s happening, or a tool to check a file before you use it.',
    examples: ['Simple dashboards and internal apps', 'Forms for collecting reports or feedback', 'Tools for checking, cleaning, and exporting data'],
  },
  {
    id: 'automation',
    symbol: '↻',
    title: 'Less busywork.',
    description: 'If you keep copying the same information between systems or repeating the same steps, there may be a better way. I connect software and automate those jobs so they’re easier to keep up with.',
    examples: ['Move information between apps', 'Turn a repeated task into a script', 'Find and fix the spots where data gets stuck'],
  },
];
---

<BaseLayout
  title="Services"
  description="Need a website, a small software tool, or help cutting down repetitive work? See how Jacob Huber can help."
>
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">How I can help</p>
      <h1 class="display-title">What are you<br />working on?</h1>
      <p class="lede">
        Maybe it’s a website you’ve been meaning to update. Maybe it’s a task
        you’re tired of doing by hand. I like figuring those things out.
      </p>
    </header>

    <div class="service-list">
      {services.map((service) => (
        <section class="service-card" aria-labelledby={`service-${service.id}`}>
          <div class="service-description">
            <span class="service-symbol" aria-hidden="true">{service.symbol}</span>
            <h2 id={`service-${service.id}`}>{service.title}</h2>
            <p>{service.description}</p>
          </div>
          <div class="service-examples">
            <p>A few things I can help with:</p>
            <ul>
              {service.examples.map((example) => <li>{example}</li>)}
            </ul>
          </div>
        </section>
      ))}
    </div>

    <section class="section split-layout approach" aria-labelledby="approach-heading">
      <div>
        <h2 id="approach-heading">You don’t need it<br />all figured out.</h2>
      </div>
      <div class="prose-copy">
        <p>
          Send me the rough idea. A link to your current site, a description of
          what’s getting in the way, or even “I wish this were easier” is a good start.
        </p>
        <p>
          We can talk through what you need and what would be worth building first.
        </p>
        <div class="service-actions">
          <a class="button" href={withBase('/contact/')}>Tell me about it <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={withBase('/projects/')}>See what I’ve made <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .service-list { display: grid; gap: 1.5rem; }
  .service-card { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--line, #e4ded2); border-radius: 20px; background: var(--paper, #fffdf7); }
  .service-card:nth-child(2) { background: #f1f3e6; }
  .service-symbol { display: inline-flex; width: 3rem; height: 3rem; align-items: center; justify-content: center; border-radius: 12px; background: var(--peach, #f6c8a7); color: var(--ink, #202d28); font-size: 1.7rem; line-height: 1; }
  .service-card:nth-child(2) .service-symbol { background: var(--accent, #ddea8e); }
  .service-description h2 { max-width: 20ch; font-size: clamp(1.9rem, 3vw, 2.65rem); margin: 1.2rem 0 1rem; }
  .service-description > p { max-width: 50ch; color: var(--muted, #5b6860); font-size: 1rem; line-height: 1.8; }
  .service-examples > p { margin: 0 0 1rem; color: var(--ink, #202d28); font-weight: 600; font-size: 0.9rem; }
  .service-examples ul { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .service-examples li { display: flex; align-items: baseline; gap: 0.8rem; color: var(--muted, #5b6860); font-size: 0.95rem; line-height: 1.6; }
  .service-examples li::before { content: '✓'; flex-shrink: 0; color: var(--forest, #214c3f); font-size: 0.9rem; }
  .approach h2 { max-width: 20ch; }
  .service-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin-top: 2rem; }

  @media (max-width: 720px) {
    .service-card { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
    .service-description h2 { max-width: 22ch; }
  }
</style>
