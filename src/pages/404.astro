---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout title="Page not found" noindex>
  <div class="container">
    <section class="page-intro">
      <p class="eyebrow">404 / A wrong turn</p>
      <h1 class="display-title">Let’s get you<br />back on track.</h1>
      <p class="lede">This page may have moved. My experience, projects, and contact details are all a click away.</p>
      <a class="button" style="margin-top: 28px" href={withBase('/')}>Back to home <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</BaseLayout>
