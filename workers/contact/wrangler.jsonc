{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "huber-builds-contact",
  "main": "index.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "contact.huberbuilds.com", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://huberbuilds.com,https://www.huberbuilds.com",
    "RESEND_FROM_EMAIL": "enquiries@huberbuilds.com"
  },
  "ratelimits": [{
    "name": "CONTACT_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}
