  },
  "dependencies": {
    "astro": "7.3.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.7.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "wrangler": "4.133.0"
  }
}
